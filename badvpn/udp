#!/usr/bin/env bash
# Wrapper calibrado de BadVPN UDPGW (1GB RAM / 100+ usuarios)
porta="${1:-7300}"
ulimit -n 65535 2>/dev/null || true
BIN="/usr/local/bin/badvpn-udpgw"
[[ ! -x "$BIN" ]] && BIN="/bin/badvpn-udpgw"
exec "$BIN" --listen-addr "127.0.0.1:${porta}" --max-clients 512 --max-connections-for-client 16 --client-socket-sndbuf 65536 >/dev/null 2>&1
