#!/bin/bash
# lang=auto badvpn
[[ -f /bin/sshplus_lang ]] && . /bin/sshplus_lang

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[44;1;37m'
WHITE='\033[1;37m'
NC='\033[0m'
DEFAULT_PORT=7300

_bad_lang="${SSHPLUS_LANG:-es}"
_bad_tr() {
    local key="$1"
    if [[ "$_bad_lang" == "en" ]]; then
        case "$key" in
            title) echo "MANAGE BADVPN" ;;
            ports) echo "PORTS" ;;
            toggle) echo "ENABLE BADVPN (DEFAULT 7300)" ;;
            open_port) echo "OPEN PORT" ;;
            back) echo "BACK" ;;
            prompt) echo "WHAT DO YOU WANT TO DO?" ;;
            disabling) echo "DISABLING BADVPN" ;;
            disabled) echo "BADVPN DISABLED SUCCESSFULLY." ;;
            starting) echo "STARTING BADVPN..." ;;
            enabled) echo "BADVPN ENABLED SUCCESSFULLY." ;;
            port_prompt) echo "WHICH PORT DO YOU WANT TO USE?" ;;
            invalid_port) echo "Invalid port!" ;;
            starting_port) echo "STARTING BADVPN ON PORT" ;;
            port_enabled) echo "PORT ENABLED SUCCESSFULLY" ;;
            unavailable) echo "FUNCTION NOT AVAILABLE" ;;
            enable_first) echo "ENABLE BADVPN FIRST." ;;
            returning) echo "Returning..." ;;
            invalid_option) echo "Invalid option!" ;;
            installing_bin) echo "Installing badvpn-udpgw binary..." ;;
            install_failed) echo "Could not install badvpn-udpgw. Check internet connection and apt/cmake dependencies." ;;
            missing_bin) echo "badvpn-udpgw binary was not found." ;;
        esac
    else
        case "$key" in
            title) echo "GESTIONAR BADVPN" ;;
            ports) echo "PUERTOS" ;;
            toggle) echo "ACTIVAR BADVPN (PREDETERMINADO 7300)" ;;
            open_port) echo "ABRIR PUERTO" ;;
            back) echo "VOLVER" ;;
            prompt) echo "QUE DESEA HACER?" ;;
            disabling) echo "DESACTIVANDO BADVPN" ;;
            disabled) echo "BADVPN DESACTIVADO CORRECTAMENTE." ;;
            starting) echo "INICIANDO BADVPN..." ;;
            enabled) echo "BADVPN ACTIVADO CORRECTAMENTE." ;;
            port_prompt) echo "QUE PUERTO DESEA USAR?" ;;
            invalid_port) echo "Puerto no valido!" ;;
            starting_port) echo "INICIANDO BADVPN EN PUERTO" ;;
            port_enabled) echo "PUERTO ACTIVADO CORRECTAMENTE" ;;
            unavailable) echo "FUNCION NO DISPONIBLE" ;;
            enable_first) echo "ACTIVE BADVPN PRIMERO." ;;
            returning) echo "Volviendo..." ;;
            invalid_option) echo "Opcion no valida!" ;;
            installing_bin) echo "Instalando binario badvpn-udpgw..." ;;
            install_failed) echo "No se pudo instalar badvpn-udpgw. Revise la conexion a internet y dependencias apt/cmake." ;;
            missing_bin) echo "No se encontro el binario badvpn-udpgw." ;;
        esac
    fi
}

_running() { ps x | grep -w udpvpn | grep -v grep >/dev/null 2>&1; }
_ports() { netstat -nplt 2>/dev/null | grep 'badvpn-ud' | awk '{print $4}' | grep -oE '[0-9]+$' | xargs; }
_status_mark() { _running && printf "${GREEN}o${NC}" || printf "${RED}x${NC}"; }

install_badvpn_bin() {
    local version="${BADVPN_VERSION:-1.999.130}"
    local workdir="/usr/local/src"
    local archive="badvpn-${version}.tar.gz"
    local src_dir="badvpn-${version}"
    local url="https://github.com/ambrop72/badvpn/archive/refs/tags/${version}.tar.gz"

    command -v apt-get >/dev/null 2>&1 || return 1
    mkdir -p "$workdir" || return 1

    DEBIAN_FRONTEND=noninteractive apt-get install -y ca-certificates curl build-essential cmake make gcc g++ >/dev/null 2>&1 || {
        apt-get update -y >/dev/null 2>&1 || true
        DEBIAN_FRONTEND=noninteractive apt-get install -y ca-certificates curl build-essential cmake make gcc g++ >/dev/null 2>&1 || return 1
    }

    cd "$workdir" || return 1
    rm -rf "$src_dir" "${src_dir}-build" "$archive"
    curl -fL "$url" -o "$archive" >/dev/null 2>&1 || return 1
    tar -xzf "$archive" >/dev/null 2>&1 || return 1
    mkdir -p "${src_dir}-build" || return 1
    cd "${src_dir}-build" || return 1
    cmake "../${src_dir}" -DCMAKE_INSTALL_PREFIX=/usr/local -DBUILD_NOTHING_BY_DEFAULT=1 -DBUILD_UDPGW=1 >/dev/null 2>&1 || return 1
    make -j"$(nproc 2>/dev/null || echo 1)" >/dev/null 2>&1 || return 1
    make install >/dev/null 2>&1 || return 1

    [[ -x /usr/local/bin/badvpn-udpgw ]] || return 1
    ln -sf /usr/local/bin/badvpn-udpgw /bin/badvpn-udpgw
    chmod +x /usr/local/bin/badvpn-udpgw /bin/badvpn-udpgw 2>/dev/null || true
}

ensure_bin() {
    [[ -x /bin/badvpn-udpgw ]] && return 0
    if [[ -x /usr/local/bin/badvpn-udpgw ]]; then
        ln -sf /usr/local/bin/badvpn-udpgw /bin/badvpn-udpgw
        return 0
    fi
    echo -e "${YELLOW}$(_bad_tr installing_bin)${NC}"
    if install_badvpn_bin; then
        return 0
    fi
    echo -e "${RED}[x] $(_bad_tr missing_bin)${NC}"
    echo -e "${RED}[x] $(_bad_tr install_failed)${NC}"
    return 1
}

stop_badvpn() {
    for sid in $(screen -ls 2>/dev/null | grep '\.udpvpn' | awk '{print $1}'); do
        screen -r -S "$sid" -X quit 2>/dev/null || true
    done
    pkill -f 'badvpn-udpgw --listen-addr' 2>/dev/null || true
    [[ -f /etc/autostart ]] && sed -i '/udpvpn/d' /etc/autostart 2>/dev/null || true
    screen -wipe >/dev/null 2>&1 || true
}

start_badvpn_port() {
    local port="$1"
    ensure_bin || return 1
    screen -dmS udpvpn /bin/badvpn-udpgw --listen-addr 127.0.0.1:"$port" --max-clients 9000 --max-connections-for-client 5 --client-socket-sndbuf 10000
    [[ -f /etc/autostart ]] || { echo '#!/bin/bash' >/etc/autostart; chmod +x /etc/autostart; }
    sed -i "/127.0.0.1:${port}/d" /etc/autostart 2>/dev/null || true
    echo "ps x | grep '127.0.0.1:${port}' | grep -v 'grep' || screen -dmS udpvpn /bin/badvpn-udpgw --listen-addr 127.0.0.1:${port} --max-clients 9000 --max-connections-for-client 5 --client-socket-sndbuf 10000" >>/etc/autostart
}

header() {
    clear
    echo -e "${WHITE}=========================================${NC}"
    echo -e "${BLUE}          $(_bad_tr title)          ${NC}"
    echo -e "${WHITE}=========================================${NC}"
    if _running; then
        echo -e "${WHITE}$(_bad_tr ports): ${GREEN}$(_ports)${NC}"
    fi
    echo ""
}

menu_badvpn() {
    while true; do
        header
        echo -e "${RED}[${GREEN}1${RED}] ${WHITE}> $(_bad_tr toggle) $(_status_mark)${NC}"
        echo -e "${RED}[${GREEN}2${RED}] ${WHITE}> $(_bad_tr open_port)${NC}"
        echo -e "${RED}[${GREEN}0${RED}] ${WHITE}> $(_bad_tr back)${NC}"
        echo ""
        echo -ne "${GREEN}$(_bad_tr prompt) ${WHITE}"
        read -r resposta
        case "$resposta" in
            1)
                if _running; then
                    header
                    echo -e "${GREEN}$(_bad_tr disabling)${NC}"
                    stop_badvpn
                    echo -e "${GREEN}$(_bad_tr disabled)${NC}"
                    sleep 2
                else
                    header
                    echo -e "${GREEN}$(_bad_tr starting)${NC}"
                    start_badvpn_port "$DEFAULT_PORT" && echo -e "${GREEN}$(_bad_tr enabled)${NC}"
                    sleep 2
                fi
                ;;
            2)
                if ! _running; then
                    header
                    echo -e "${RED}$(_bad_tr unavailable)${NC}"
                    echo -e "${WHITE}$(_bad_tr enable_first)${NC}"
                    sleep 2
                    continue
                fi
                header
                echo -ne "${GREEN}$(_bad_tr port_prompt) ${WHITE}"
                read -r porta
                if [[ ! "$porta" =~ ^[0-9]+$ ]]; then
                    echo -e "${RED}$(_bad_tr invalid_port)${NC}"
                    sleep 2
                    continue
                fi
                echo -e "${GREEN}$(_bad_tr starting_port) ${RED}${porta}${NC}"
                start_badvpn_port "$porta" && echo -e "${GREEN}${porta}: $(_bad_tr port_enabled)${NC}"
                sleep 2
                ;;
            0)
                echo -e "${RED}$(_bad_tr returning)${NC}"
                sleep 1
                menu 2>/dev/null || exit 0
                ;;
            *)
                echo -e "${RED}$(_bad_tr invalid_option)${NC}"
                sleep 1
                ;;
        esac
    done
}

menu_badvpn
