#!/bin/bash
# lang=es delscript
clear
echo -e "\033[1;32mDESEA DESINSTALAR NoxuraSSH?\033[1;33m"
echo -e "\033[1;33mSe eliminaran usuarios del panel, reglas de firewall (iptables) y se detendran los servicios instalados por el script.\033[0m"
read -p "Continuar? [s/n] " resp
if [[ "$resp" = s || "$resp" = S ]]; then

	# --- Usuarios creados por el panel (usuarios.db / SSHPlus/senha) ---
	sshplus_remove_panel_users() {
		sshplus_del_one_user() {
			local u="$1"
			[[ -z "$u" || "$u" == root ]] && return 0
			grep -q "^${u}:" /etc/passwd 2>/dev/null || return 0
			pkill -KILL -u "$u" 2>/dev/null
			sleep 1
			deluser --force "$u" 2>/dev/null || userdel -f "$u" 2>/dev/null
		}
		for _db in /root/usuarios.db /bin/usuarios.db; do
			[[ -f "$_db" ]] || continue
			while read -r line || [[ -n "$line" ]]; do
				[[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
				u="${line%% *}"
				sshplus_del_one_user "$u"
			done < "$_db"
		done
		if [[ -d /etc/SSHPlus/senha ]]; then
			for _f in /etc/SSHPlus/senha/*; do
				[[ -f "$_f" ]] || continue
				u=$(basename "$_f")
				sshplus_del_one_user "$u"
			done
		fi
		rm -f /root/usuarios.db /bin/usuarios.db /root/namee 2>/dev/null
		rm -rf /etc/SSHPlus 2>/dev/null
	}

	# --- Quitar bloqueo torrent / reglas personalizadas (blockt) ---
	sshplus_flush_iptables() {
		command -v ufw >/dev/null 2>&1 && {
			ufw disable 2>/dev/null
			ufw --force reset 2>/dev/null
		}
		iptables -P INPUT ACCEPT 2>/dev/null
		iptables -P OUTPUT ACCEPT 2>/dev/null
		iptables -P FORWARD ACCEPT 2>/dev/null
		iptables -t mangle -F 2>/dev/null
		iptables -t mangle -X 2>/dev/null
		iptables -t nat -F 2>/dev/null
		iptables -t nat -X 2>/dev/null
		iptables -t filter -F 2>/dev/null
		iptables -t filter -X 2>/dev/null
		iptables -F 2>/dev/null
		iptables -X 2>/dev/null
		rm -f /etc/Plus-torrent
		command -v ip6tables >/dev/null 2>&1 && {
			ip6tables -P INPUT ACCEPT 2>/dev/null
			ip6tables -P OUTPUT ACCEPT 2>/dev/null
			ip6tables -P FORWARD ACCEPT 2>/dev/null
			ip6tables -F 2>/dev/null
			ip6tables -X 2>/dev/null
		}
		command -v nft >/dev/null 2>&1 && nft flush ruleset 2>/dev/null || true
	}

	# --- Limpeza profunda (servicos, cron, sysctl, menu seguro) ---
	sshplus_stop_services() {
		pkill -9 -f trojan-go 2>/dev/null
		pkill -9 -f v2ray 2>/dev/null
		pkill -9 -f xray 2>/dev/null
		pkill -9 -f badvpn 2>/dev/null
		pkill -9 -f slowdns 2>/dev/null
		pkill -9 -f wsproxy 2>/dev/null

		systemctl stop fail2ban 2>/dev/null
		systemctl disable fail2ban 2>/dev/null
		systemctl stop nginx 2>/dev/null
		systemctl disable nginx 2>/dev/null
		systemctl stop webmin 2>/dev/null
		systemctl disable webmin 2>/dev/null

		systemctl stop badvpn-udpgw 2>/dev/null
		systemctl disable badvpn-udpgw 2>/dev/null
		rm -f /etc/systemd/system/badvpn-udpgw.service

		systemctl stop slowdns 2>/dev/null
		systemctl disable slowdns 2>/dev/null
		rm -f /etc/systemd/system/slowdns.service

		systemctl stop sshplus-websocket 2>/dev/null
		systemctl disable sshplus-websocket 2>/dev/null
		rm -f /etc/systemd/system/sshplus-websocket.service
		systemctl daemon-reload 2>/dev/null

		systemctl stop v2ray 2>/dev/null
		systemctl disable v2ray 2>/dev/null
		systemctl stop xray 2>/dev/null
		systemctl disable xray 2>/dev/null
		systemctl stop stunnel4 2>/dev/null
		systemctl stop sslh 2>/dev/null
		systemctl stop danted 2>/dev/null
		systemctl stop danted.service 2>/dev/null
		systemctl stop openvpn@server 2>/dev/null
		systemctl stop openvpn 2>/dev/null
	}

	sshplus_purge_extras() {
		DEBIAN_FRONTEND=noninteractive apt-get purge -y \
			stunnel4 sslh dante-server openvpn fail2ban 2>/dev/null
		DEBIAN_FRONTEND=noninteractive apt-get purge -y nginx nginx-common nginx-full 2>/dev/null
		DEBIAN_FRONTEND=noninteractive apt-get purge -y webmin 2>/dev/null
		apt-get autoremove -y >/dev/null 2>&1
	}

	sshplus_remove_files_extra() {
		rm -f /etc/IP 2>/dev/null
	rm -f /usr/local/bin/menu /usr/local/sbin/menu /usr/bin/menu /usr/bin/conexao /usr/bin/connection 2>/dev/null
	rm -f /bin/ajuda /bin/help /bin/detalhes /bin/details /bin/otimizar /bin/optimize /bin/painelv2ray /bin/v2raypanel /bin/reiniciarservicos /bin/restartservices /bin/reiniciarsistema /bin/restartsystem /bin/senharoot /bin/rootpass /bin/trafegototal /bin/totaltraffic /bin/versao /bin/version /bin/verifatt /bin/checkupdate /bin/verifbot /bin/checkbot /bin/botteste /bin/testbot /bin/botteste.sh /bin/testbot.sh /bin/inst-botteste /bin/install-testbot 2>/dev/null
		systemctl stop hysteria-server >/dev/null 2>&1 || true
		systemctl disable hysteria-server >/dev/null 2>&1 || true
		rm -f /etc/systemd/system/hysteria-server.service /usr/local/bin/hysteria /usr/local/bin/hysteria1 /usr/bin/hysteria /bin/hysteria /bin/hysteria-menu 2>/dev/null
		rm -rf /etc/hysteria 2>/dev/null
		systemctl daemon-reload >/dev/null 2>&1 || true
		rm -f /usr/local/bin/dnstt-server /usr/bin/dnstt-server /bin/dnstt-server 2>/dev/null
		rm -rf /etc/slowdns /var/log/slowdns.log 2>/dev/null
		rm -rf /etc/v2ray /usr/local/etc/v2ray /var/log/v2ray 2>/dev/null
		rm -rf /etc/xray /usr/local/etc/xray /var/log/xray 2>/dev/null
		rm -f /usr/bin/v2ray /usr/local/bin/v2ray /bin/v2ray /usr/bin/xray /usr/local/bin/xray /bin/xray 2>/dev/null
		rm -f /usr/local/bin/badvpn-udpgw 2>/dev/null
		rm -rf /usr/local/src/badvpn-* 2>/dev/null
		rm -rf /tmp/badvpn-* /tmp/sshplus-* 2>/dev/null
		rm -f /usr/lib/licence /usr/lib/sshplus /etc/rec/licence 2>/dev/null
		rm -rf /etc/rec 2>/dev/null
		rm -f /etc/sysctl.d/70-disable-ipv6.conf 2>/dev/null
		sysctl --system >/dev/null 2>&1 || true
		rm -f /etc/autostart 2>/dev/null
		rm -rf /home/sshplus 2>/dev/null
		rm -rf /var/www/html/server /var/www/html/backup 2>/dev/null
		rm -f /var/log/sshplus-proxy.log /var/log/sshplus-wsproxy.log 2>/dev/null
		swapoff /bin/ram.img >/dev/null 2>&1 || true
		sed -i '\#/bin/ram.img#d' /etc/fstab 2>/dev/null || true
		rm -f /bin/ram.img 2>/dev/null
		userdel badvpn 2>/dev/null || true
	}

	sshplus_fix_crontab() {
		if ! command -v crontab >/dev/null 2>&1; then
			return 0
		fi
		local _cr
		_cr=$(mktemp)
		if crontab -l >"$_cr" 2>/dev/null; then
			grep -v '/bin/checkupdate' "$_cr" | grep -v '/etc/autostart' | grep -v 'autostart' | crontab - 2>/dev/null || true
		fi
		rm -f "$_cr"
	}

	sshplus_strip_root_bashrc() {
		[[ ! -f /root/.bashrc ]] && return 0
		awk '
			/NOXURASSH_BANNER_START/ {skip=1; next}
			/NOXURASSH_BANNER_END/ {skip=0; next}
			skip {next}
			{print}
		' /root/.bashrc | grep -v -E 'figlet|lolcat|NoxuraSSH|SSHPLUS|NoxuraSSH|by J DAVID AG|ALFAINTERNET|JDAVIDAG1|Dev\. J DAVID AG|Desarrollado por|DIGITE \( menu \)|ESCRIBA:|ESCRIBA \( menu \)|NOME DO SERVIDOR|NOMBRE DEL SERVIDOR|SERVIDOR LIGADO|SERVIDOR EN MARCHA|FECHA:|FECHA :|HORA:|HORA :|DATE=\$\(date|TIME=\$\(date|CYAN=\$|WHITE=\$|GREEN=\$|RESET=\$|echo -e "\$\{CYAN\}=+|echo -e ""|^clear$|@ALFAINTERNET|@JDAVIDAG1' > /tmp/.bashrc.sshplus.tmp 2>/dev/null &&
			mv /tmp/.bashrc.sshplus.tmp /root/.bashrc
	}

	sshplus_restore_bashrc_if_missing() {
		[[ -s /root/.bashrc ]] && return 0
		if [[ -f /etc/skel/.bashrc ]]; then
			cp /etc/skel/.bashrc /root/.bashrc
		else
			echo '# ~/.bashrc - restaurado apos remocao NoxuraSSH' >/root/.bashrc
		fi
		chmod 644 /root/.bashrc
	}

	sshplus_remove_panel_users
	sshplus_flush_iptables
	sshplus_stop_services
	sshplus_remove_files_extra
	sshplus_fix_crontab
	sshplus_strip_root_bashrc

	apt-get purge screen -y >/dev/null 2>&1
	apt-get purge nmap -y >/dev/null 2>&1
	apt-get purge figlet -y >/dev/null 2>&1
	apt-get purge squid -y >/dev/null 2>&1
	apt-get purge squid3 -y >/dev/null 2>&1
	apt-get purge dropbear -y >/dev/null 2>&1
	apt-get purge apache2 -y >/dev/null 2>&1
	sshplus_purge_extras

