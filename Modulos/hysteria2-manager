#!/usr/bin/env bash
# ==============================================================================
#  HYSTERIA 2 MANAGER — Gestor Oficial Hysteria v2 para SSH-CRIS / HTTP Conexión
# ==============================================================================

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'
NC='\033[0m'
SCOLOR='\033[0m'
SSHPLUS_NUM=$'\033[1;38;2;0;255;127m'
SSHPLUS_CYAN=$'\033[1;38;2;76;228;255m'
SSHPLUS_DARK_GREEN=$'\033[0;32m'

INSTALL_DIR="/etc/hysteria2"
CONFIG_FILE="${INSTALL_DIR}/config.yaml"
BINARY_PATH="/usr/local/bin/hysteria2"
SERVICE_NAME="hysteria2.service"
SERVICE_FILE="/etc/systemd/system/${SERVICE_NAME}"
CERT_FILE="${INSTALL_DIR}/server.crt"
KEY_FILE="${INSTALL_DIR}/server.key"

hy2_resize() {
    SSHPLUS_COLS="$(tput cols 2>/dev/null || echo 80)"
    [[ ! "$SSHPLUS_COLS" =~ ^[0-9]+$ ]] && SSHPLUS_COLS=80
    SSHPLUS_IW=60
    [[ "$SSHPLUS_COLS" -lt 62 ]] && SSHPLUS_IW=$(( SSHPLUS_COLS - 2 ))
    [[ "$SSHPLUS_IW" -lt 42 ]] && SSHPLUS_IW=42
}

hy2_line() {
    local i
    hy2_resize
    printf '%b' "$SSHPLUS_CYAN"
    for ((i=0;i<SSHPLUS_IW;i++)); do printf '='; done
    printf '\033[0m\n'
}

hy2_title() {
    local title="$1" pad
    hy2_resize
    hy2_line
    pad=$(( (SSHPLUS_IW - ${#title}) / 2 ))
    [[ "$pad" -lt 0 ]] && pad=0
    printf '%*s%b%s\033[0m\n' "$pad" "" "$SSHPLUS_CYAN" "$title"
    hy2_line
}

hy2_opt() {
    local n="${1#0}"
    [[ -z "$n" ]] && n="0"
    printf '%b[%s]\033[0m \033[1;37m>\033[0m \033[1;37m%s\033[0m %b\n' "$SSHPLUS_NUM" "$n" "$2" "$3"
}

pause_hy2() {
    echo ""
    echo -e "\033[1;37m* \033[1;33mPresione Enter para continuar...\033[0m"
    read -r _
}

get_public_ip() {
    local ip
    ip=$(curl -4 -s --max-time 3 https://api.ipify.org 2>/dev/null || \
         curl -4 -s --max-time 3 https://icanhazip.com 2>/dev/null || \
         curl -4 -s --max-time 3 https://ifconfig.me 2>/dev/null || \
         cat /etc/IP 2>/dev/null || echo "127.0.0.1")
    echo "$ip" | tr -d ' \n\r'
}

ensure_dirs() {
    mkdir -p "${INSTALL_DIR}"
}

ensure_binary() {
    if [[ -x "$BINARY_PATH" ]]; then
        return 0
    fi
    if [[ -x "/usr/bin/hysteria" && "$(/usr/bin/hysteria version 2>/dev/null | grep -q 'v2')" ]]; then
        ln -sfn /usr/bin/hysteria "$BINARY_PATH"
        return 0
    fi
    if [[ -x "/usr/local/bin/hysteria" && "$(/usr/local/bin/hysteria version 2>/dev/null | grep -q 'v2')" ]]; then
        ln -sfn /usr/local/bin/hysteria "$BINARY_PATH"
        return 0
    fi

    echo -e "${YELLOW}[*] Descargando Hysteria v2 oficial...${NC}"
    local arch; arch=$(uname -m)
    case "$arch" in
        x86_64) arch="amd64" ;;
        aarch64|arm64) arch="arm64" ;;
        armv7l|armhf) arch="armv7" ;;
        *) arch="amd64" ;;
    esac

    local url="https://github.com/apernet/hysteria/releases/latest/download/hysteria-linux-${arch}"
    curl -fsSL "$url" -o "$BINARY_PATH" 2>/dev/null || \
    wget -q "$url" -O "$BINARY_PATH" 2>/dev/null || \
    bash <(curl -fsSL https://get.hy2.sh/) 2>/dev/null || true

    if [[ -x /usr/bin/hysteria ]]; then
        ln -sfn /usr/bin/hysteria "$BINARY_PATH" 2>/dev/null || true
    fi

    chmod 755 "$BINARY_PATH" 2>/dev/null || true
    ln -sfn "$BINARY_PATH" /bin/hysteria2 2>/dev/null || true
    ln -sfn "$BINARY_PATH" /usr/bin/hysteria2 2>/dev/null || true
    [[ -x "$BINARY_PATH" ]]
}

ensure_certificates() {
    local domain="${1:-crisdev.online}"
    ensure_dirs
    if [[ ! -f "$CERT_FILE" || ! -f "$KEY_FILE" ]]; then
        echo -e "${YELLOW}[*] Generando certificado TLS para Hysteria 2 (CN: ${domain})...${NC}"
        openssl req -x509 -newkey rsa:2048 -days 3650 -nodes \
            -keyout "$KEY_FILE" -out "$CERT_FILE" \
            -subj "/CN=${domain}" >/dev/null 2>&1 || true
        chmod 600 "$KEY_FILE" 2>/dev/null || true
        chmod 644 "$CERT_FILE" 2>/dev/null || true
    fi
}

is_running() {
    systemctl is-active --quiet "$SERVICE_NAME" 2>/dev/null || pgrep -f 'hysteria2|hysteria server' >/dev/null 2>&1
}

get_current_port() {
    local port="443"
    if [[ -f "$CONFIG_FILE" ]]; then
        port=$(grep -E '^[[:space:]]*listen:' "$CONFIG_FILE" 2>/dev/null | awk '{print $2}' | tr -d ' ":' | head -1)
    fi
    if [[ -z "$port" ]]; then
        port=$(ss -ulnp 2>/dev/null | grep -E "hysteria2|hysteria" | awk '{print $5}' | grep -oE '[0-9]+$' | head -1)
    fi
    echo "${port:-443}"
}

get_current_auth() {
    local auth="crisdev123"
    if [[ -f "$CONFIG_FILE" ]]; then
        auth=$(grep -E '^[[:space:]]*password:' "$CONFIG_FILE" 2>/dev/null | head -1 | awk '{print $2}' | tr -d ' "')
    fi
    echo "${auth:-crisdev123}"
}

get_current_obfs() {
    local obfs=""
    if [[ -f "$CONFIG_FILE" ]]; then
        obfs=$(grep -E '^[[:space:]]*password:' "$CONFIG_FILE" 2>/dev/null | tail -1 | awk '{print $2}' | tr -d ' "')
        if ! grep -q 'salamander' "$CONFIG_FILE" 2>/dev/null; then
            obfs=""
        fi
    fi
    echo "$obfs"
}

get_current_sni() {
    local sni="bing.com"
    if [[ -f "$CONFIG_FILE" ]]; then
        sni=$(grep -E '^[[:space:]]*url:' "$CONFIG_FILE" 2>/dev/null | awk '{print $2}' | sed -e 's#https://##' -e 's#/##g' | tr -d ' "')
    fi
    echo "${sni:-bing.com}"
}

generate_config_yaml() {
    local port="${1:-443}"
    local auth="${2:-crisdev123}"
    local obfs_pass="${3:-}"
    local sni_dom="${4:-bing.com}"

    ensure_dirs
    ensure_certificates "$sni_dom"

    local obfs_block=""
    if [[ -n "$obfs_pass" ]]; then
        obfs_block="obfs:
  type: salamander
  salamander:
    password: \"${obfs_pass}\""
    fi

    cat > "$CONFIG_FILE" <<EOF
listen: :${port}

tls:
  cert: ${CERT_FILE}
  key: ${KEY_FILE}

auth:
  type: password
  password: "${auth}"

${obfs_block}

quic:
  initStreamReceiveWindow: 8388608
  maxStreamReceiveWindow: 8388608
  initConnReceiveWindow: 20971520
  maxConnReceiveWindow: 20971520
  maxIdleTimeout: 30s
  keepAlivePeriod: 10s

bandwidth:
  up: 1 Gbps
  down: 1 Gbps

masquerade:
  type: proxy
  proxy:
    url: https://${sni_dom}/
    rewriteHost: true

ignoreClientBandwidth: false
disableUDP: false
EOF
    chmod 600 "$CONFIG_FILE"
}

create_service() {
    cat > "$SERVICE_FILE" <<EOF
[Unit]
Description=Hysteria 2 Server - HTTP Conexión
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=${INSTALL_DIR}
ExecStart=${BINARY_PATH} server --config ${CONFIG_FILE}
Restart=always
RestartSec=3s
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
EOF
    chmod 644 "$SERVICE_FILE"
    systemctl daemon-reload >/dev/null 2>&1 || true
}

start_service() {
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable --now "$SERVICE_NAME" >/dev/null 2>&1 || true
}

stop_service() {
    systemctl stop "$SERVICE_NAME" >/dev/null 2>&1 || true
    systemctl disable "$SERVICE_NAME" >/dev/null 2>&1 || true
    pkill -9 -f 'hysteria2' >/dev/null 2>&1 || true
}

restart_service() {
    systemctl restart "$SERVICE_NAME" >/dev/null 2>&1 || true
}

open_firewall_port() {
    local port="$1"
    iptables -I INPUT -p udp --dport "$port" -j ACCEPT 2>/dev/null || true
    ufw allow "${port}/udp" 2>/dev/null || true
}

menu_configurar_puerto() {
    clear
    hy2_title "CONFIGURAR PUERTO HYSTERIA 2"
    ensure_dirs
    ensure_binary || {
        echo -e "${RED}[ERROR] No se pudo instalar el binario Hysteria 2.${NC}"
        pause_hy2
        return
    }

    local cur_p; cur_p=$(get_current_port)
    local cur_a; cur_a=$(get_current_auth)
    local cur_o; cur_o=$(get_current_obfs)
    local cur_s; cur_s=$(get_current_sni)

    echo -e "${WHITE}Puertos UDP recomendados para Hysteria 2:${NC}"
    echo -e "  • \033[1;33m443\033[0m (Estándar QUIC / HTTPS UDP)"
    echo -e "  • \033[1;33m8443\033[0m / \033[1;33m7800\033[0m (Alternativos)"
    echo -e "  • \033[1;33m20000:50000\033[0m (Multi-port Hopping)"
    echo ""
    echo -ne "${SSHPLUS_DARK_GREEN}Ingrese el puerto a configurar [Enter = ${cur_p}]:${SCOLOR} "
    read -r in_port
    [[ -z "$in_port" ]] && in_port="$cur_p"

    echo ""
    echo -ne "${SSHPLUS_DARK_GREEN}Contraseña de conexión / Auth [Enter = ${cur_a}]:${SCOLOR} "
    read -r in_auth
    [[ -z "$in_auth" ]] && in_auth="$cur_a"

    echo ""
    echo -e "${WHITE}¿Desea activar ofuscación Salamander (Bypass DPI)?${NC}"
    echo -e "  ${GREEN}[1]${NC} \033[1;37m> Si (Recomendado para saltar bloqueos de operadores)${NC}"
    echo -e "  ${GREEN}[2]${NC} \033[1;37m> No (Hysteria 2 Estándar)${NC}"
    echo -ne "${SSHPLUS_DARK_GREEN}Opción [Enter = 1]:${SCOLOR} "
    read -r o_opt
    local in_obfs="$cur_o"
    if [[ "$o_opt" == "2" ]]; then
        in_obfs=""
    else
        [[ -z "$in_obfs" ]] && in_obfs="crisdev_salamander"
        echo -ne "${SSHPLUS_DARK_GREEN}Clave de ofuscación Salamander [Enter = ${in_obfs}]:${SCOLOR} "
        read -r custom_obfs
        [[ -n "$custom_obfs" ]] && in_obfs="$custom_obfs"
    fi

    echo ""
    echo -ne "${SSHPLUS_DARK_GREEN}Dominio SNI / Masquerade Web [Enter = ${cur_s}]:${SCOLOR} "
    read -r in_sni
    [[ -z "$in_sni" ]] && in_sni="$cur_s"

    generate_config_yaml "$in_port" "$in_auth" "$in_obfs" "$in_sni"
    create_service
    start_service
    open_firewall_port "$in_port"

    sleep 1
    echo ""
    hy2_line
    if is_running; then
        echo -e "\033[1;32m✔ Servidor Hysteria 2 activo y escuchando en el puerto UDP ${in_port}! ⚡\033[0m"
        echo -e "${WHITE}Auth Password:${NC} \033[1;33m${in_auth}\033[0m"
        [[ -n "$in_obfs" ]] && echo -e "${WHITE}Obfs Salamander:${NC} \033[1;32m${in_obfs}\033[0m"
        echo -e "${WHITE}SNI Web Masq  :${NC} \033[1;36m${in_sni}\033[0m"
    else
        echo -e "\033[1;31m✗ No se pudo iniciar el servicio Hysteria 2.\033[0m"
        echo -e "${YELLOW}Registro de error:${NC}"
        journalctl -u "$SERVICE_NAME" -n 6 --no-pager 2>/dev/null || true
    fi
    hy2_line
    pause_hy2
}

ver_datos_conexion() {
    clear
    hy2_title "DATOS DE CONEXIÓN HYSTERIA 2"
    local ip; ip=$(get_public_ip)
    local p; p=$(get_current_port)
    local a; a=$(get_current_auth)
    local o; o=$(get_current_obfs)
    local s; s=$(get_current_sni)

    local obfs_param=""
    [[ -n "$o" ]] && obfs_param="&obfs=salamander&obfs-password=${o}"

    local hy2_url="hysteria2://${a}@${ip}:${p}/?sni=${s}&insecure=1${obfs_param}#HTTP_Conexion-HY2"

    printf "  \033[1;32m%-22s\033[0m \033[1;37m%s\033[0m\n" "HOST / IP SERVIDOR:" "$ip"
    printf "  \033[1;32m%-22s\033[0m \033[1;37m%s\033[0m\n" "PUERTO UDP:" "$p"
    printf "  \033[1;32m%-22s\033[0m \033[1;37m%s\033[0m\n" "PASSWORD / AUTH:" "$a"
    printf "  \033[1;32m%-22s\033[0m \033[1;37m%s\033[0m\n" "OFUSCACIÓN (OBFS):" "${o:-Desactivada}"
    printf "  \033[1;32m%-22s\033[0m \033[1;37m%s\033[0m\n" "SNI / DOMINIO:" "$s"
    hy2_line
    echo -e "\033[1;33mENLACE OFICIAL HYSTERIA 2:\033[0m"
    echo -e "\033[1;36m${hy2_url}\033[0m"
    hy2_line
    echo -e "\033[1;37mUse estos datos en la App HTTP Conexión o GEN (Tipo: UDP HYSTERIA v2).\033[0m"
    pause_hy2
}

ver_logs_hy2() {
    clear
    hy2_title "REGISTRO EN VIVO HYSTERIA 2"
    journalctl -u "$SERVICE_NAME" -n 25 --no-pager 2>/dev/null || systemctl status "$SERVICE_NAME" --no-pager 2>/dev/null || echo "Sin registros disponibles."
    echo ""
    hy2_line
    pause_hy2
}

desinstalar_hy2() {
    clear
    hy2_title "DESINSTALAR HYSTERIA 2"
    echo -ne "${RED}¿Está seguro de detener y desinstalar Hysteria 2? [s/N]: ${NC}"
    read -r conf
    if [[ ! "$conf" =~ ^[sS]$ ]]; then
        return
    fi
    stop_service
    rm -f "$SERVICE_FILE"
    systemctl daemon-reload >/dev/null 2>&1 || true
    rm -rf "${INSTALL_DIR}"
    rm -f "$BINARY_PATH" /bin/hysteria2 /usr/bin/hysteria2
    echo -e "\n\033[1;32m✔ Hysteria 2 ha sido desinstalado completamente.\033[0m"
    pause_hy2
}

fun_hysteria2_manager() {
    ensure_dirs
    while true; do
        clear
        local running_sts="${RED}DETENIDO [x]${NC}"
        local cur_port; cur_port=$(get_current_port)
        local cur_auth; cur_auth=$(get_current_auth)
        local cur_obfs; cur_obfs=$(get_current_obfs)

        if is_running; then
            running_sts="${GREEN}ACTIVO [o]${NC}"
        fi

        hy2_title "GESTOR HYSTERIA v2 (QUIC UDP) — HTTP CONEXIÓN"
        echo -e "  ${WHITE}ESTADO DEL SERVICIO  : ${running_sts}"
        echo -e "  ${WHITE}PUERTO UDP EN USO    : ${YELLOW}${cur_port}/udp${NC}"
        echo -e "  ${WHITE}AUTENTICACIÓN        : ${GREEN}${cur_auth}${NC}"
        echo -e "  ${WHITE}OFUSCACIÓN SALAMANDER: ${CYAN}${cur_obfs:-Desactivada}${NC}"
        hy2_line
        hy2_opt "1" "CONFIGURAR / CAMBIAR PUERTO HYSTERIA 2"
        if is_running; then
            hy2_opt "2" "DETENER SERVICIO HYSTERIA 2"
            hy2_opt "3" "REINICIAR SERVICIO HYSTERIA 2"
        else
            hy2_opt "2" "INICIAR SERVICIO HYSTERIA 2"
        fi
        hy2_opt "4" "VER DATOS DE CONEXIÓN / ENLACE"
        hy2_opt "5" "VER REGISTRO DE LOGS EN VIVO"
        hy2_opt "6" "DESINSTALAR HYSTERIA 2"
        hy2_opt "0" "VOLVER"
        hy2_line
        echo -ne "${SSHPLUS_CYAN}Opción:${SCOLOR} "
        read -r opc
        case "$opc" in
            1|01) menu_configurar_puerto ;;
            2|02)
                if is_running; then
                    stop_service
                    echo -e "\n\033[1;33mServicio Hysteria 2 detenido.\033[0m"
                else
                    ensure_binary
                    start_service
                    echo -e "\n\033[1;32mServicio Hysteria 2 iniciado.\033[0m"
                fi
                pause_hy2
                ;;
            3|03)
                if is_running; then
                    restart_service
                    echo -e "\n\033[1;32mServicio Hysteria 2 reiniciado.\033[0m"
                    pause_hy2
                fi
                ;;
            4|04) ver_datos_conexion ;;
            5|05) ver_logs_hy2 ;;
            6|06) desinstalar_hy2 ;;
            0|00) exit 0 ;;
            *)
                echo -e "\033[1;31mOpción no válida!\033[0m"
                sleep 1
                ;;
        esac
    done
}

fun_hysteria2_manager
