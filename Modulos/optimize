# lang=es optimize v2
FREE_CMD="$(command -v free 2>/dev/null || true)"
[[ -z "$FREE_CMD" && -x /usr/bin/free ]] && FREE_CMD="/usr/bin/free"
[[ -z "$FREE_CMD" && -x /bin/free ]] && FREE_CMD="/bin/free"
fmt_kb() {
	awk -v kb="${1:-0}" 'BEGIN {
		b = kb * 1024;
		split("B KiB MiB GiB TiB", u, " ");
		i = 1;
		while (b >= 1024 && i < 5) { b /= 1024; i++ }
		printf "%.1f%s", b, u[i]
	}'
}
mem_pct() {
	if [[ -n "$FREE_CMD" ]]; then
		LC_ALL=C LANG=C "$FREE_CMD" 2>/dev/null | awk '$1 == "Mem:" && ($2+0) > 0 {print int(100*$3/$2); exit}'
	else
		awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2} END {if(t>0) print int(100*(t-a)/t); else print 0}' /proc/meminfo 2>/dev/null
	fi
}
mem_stat() {
	local key="$1" kb
	if [[ -n "$FREE_CMD" ]]; then
		LC_ALL=C LANG=C "$FREE_CMD" -h 2>/dev/null | awk -v k="$key" '$1 == "Mem:" {if(k=="total") print $2; else if(k=="used") print $3; else if(k=="free") print $4; exit}'
	else
		case "$key" in
			total) kb="$(awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null)" ;;
			used) kb="$(awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2} END {print t-a}' /proc/meminfo 2>/dev/null)" ;;
			free) kb="$(awk '/^MemAvailable:/ {print $2; exit}' /proc/meminfo 2>/dev/null)" ;;
		esac
		fmt_kb "${kb:-0}"
	fi
}
swap_stat() {
	local key="$1" kb
	if [[ -n "$FREE_CMD" ]]; then
		LC_ALL=C LANG=C "$FREE_CMD" -h 2>/dev/null | awk -v k="$key" '$1 == "Swap:" {if(k=="total") print $2; else if(k=="used") print $3; else if(k=="free") print $4; exit}'
	else
		case "$key" in
			total) kb="$(awk '/^SwapTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null)" ;;
			used) kb="$(awk '/^SwapTotal:/ {t=$2} /^SwapFree:/ {f=$2} END {print t-f}' /proc/meminfo 2>/dev/null)" ;;
			free) kb="$(awk '/^SwapFree:/ {print $2; exit}' /proc/meminfo 2>/dev/null)" ;;
		esac
		fmt_kb "${kb:-0}"
	fi
}
