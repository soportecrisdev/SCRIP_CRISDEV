#!/bin/bash
# lang=es changelimit v3-2026
database="/root/usuarios.db"
SSHPLUS_CYAN=$'\033[38;2;76;228;255m'
SSHPLUS_NUM=$'\033[1;38;2;0;255;127m'

line() { echo -e "${SSHPLUS_CYAN}============================================================\033[0m"; }
title() {
	local text="$1" cols pad
	cols="$(tput cols 2>/dev/null || echo 60)"
	[[ "$cols" =~ ^[0-9]+$ ]] || cols=60
	[[ "$cols" -gt 60 ]] && cols=60
	[[ "$cols" -lt 40 ]] && cols=40
	[[ ${#text} -gt "$cols" ]] && text="${text:0:cols}"
	pad=$(( (cols - ${#text}) / 2 ))
	[[ "$pad" -lt 0 ]] && pad=0
	printf '%*s%b\033[1m%s\033[0m\n' "$pad" "" "$SSHPLUS_CYAN" "$text"
}

valid_sshplus_user() {
	local user="$1" uid
	[[ -z "$user" || "$user" == "nobody" || "$user" == systemd-* || "$user" == "_"* ]] && return 1
	uid="$(getent passwd "$user" 2>/dev/null | awk -F: '{print $3}')"
	[[ "$uid" =~ ^[0-9]+$ && "$uid" -ge 1000 ]]
}

show_error() {
	echo ""
	tput setaf 7; tput setab 1; tput bold
	echo "$1"
	tput sgr0
	echo ""
	exit 1
}

clear
[[ -f "$database" ]] || show_error "Archivo $database no encontrado"

line
title "CAMBIAR LIMITE DE CONEXIONES"
line
echo -e "${SSHPLUS_CYAN}\033[1mUSUARIOS:                   LIMITE:\033[0m"
echo -e "${SSHPLUS_CYAN}\033[1m------------------------------------------------------------\033[0m"

i=0
unset _userPass
while read -r user limit _rest; do
	[[ -z "$user" ]] && continue
	valid_sshplus_user "$user" || continue
	[[ "$limit" =~ ^[0-9]+$ ]] || limit=1
	i=$((i + 1))
	printf '%b[%s]\033[0m \033[1;37m> %-25s %s\033[0m\n' "$SSHPLUS_NUM" "$i" "$user" "$limit"
	_userPass+="\n${i}:${user}"
done < "$database"

if [[ "$i" -eq 0 ]]; then
	echo -e "\033[1;33mNo hay usuarios SSH creados por la script.\033[0m"
	echo ""
	echo -ne "\033[1;37m* \033[1;33mEnter para volver\033[1;31m"
	read enter
	exit 0
fi
line
echo -e "${SSHPLUS_NUM}[0]\033[0m \033[1;37m> CANCELAR\033[0m"
line

echo -ne "\033[1;32mOpcion\033[1;33m: \033[0m"; read -r option
[[ "$option" == "0" || "$option" == "00" ]] && { echo -e "\033[1;33mOperación cancelada.\033[0m"; sleep 1; exit 0; }
[[ -z "$option" ]] && show_error "Usuario vacio o inexistente"

usuario="$(echo -e "${_userPass}" | grep -E "^${option}:" | cut -d: -f2)"
[[ -z "$usuario" ]] && show_error "Opción no valida. Seleccione un numero de la lista."
getent passwd "$usuario" >/dev/null 2>&1 || show_error "El usuario $usuario no fue encontrado"

cur_limit=$(grep "^$usuario " /root/usuarios.db 2>/dev/null | awk '{print $2}')
echo -ne "\n\033[1;32mNuevo limite para el usuario \033[1;33m$usuario \033[1;37m(actual: $cur_limit): "; read -r sshnum
[[ "$sshnum" =~ ^[0-9]+$ ]] || show_error "Numero invalido"
[[ "$sshnum" -gt 0 ]] || show_error "Debe ingresar un numero mayor que cero."

grep -v "^$usuario[[:space:]]" "$database" > /tmp/a
mv /tmp/a "$database"
echo "$usuario $sshnum" >> "$database"

tput setaf 7; tput setab 4; tput bold
echo ""
echo "Limite aplicado al usuario $usuario: $sshnum"
tput sgr0
echo ""
echo -ne "\033[1;37m* \033[1;33mEnter para continuar\033[1;31m"
read enter
exit 0
