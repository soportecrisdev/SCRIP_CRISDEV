#!/bin/bash
clear
echo -e "\E[44;1;37m            INFORMACIÓN DEL VPS                 \E[0m"
echo ""
if [ -f /etc/lsb-release ]
then
echo -e "\033[1;31m• \033[1;32mSISTEMA OPERATIVO\033[1;31m •\033[0m"
echo ""
name=$(cat /etc/lsb-release |grep DESCRIPTION |awk -F = {'print $2'})
codename=$(cat /etc/lsb-release |grep CODENAME |awk -F = {'print $2'})
echo -e "\033[1;33mNombre: \033[1;37m$name"
echo -e "\033[1;33mCodeName: \033[1;37m$codename"
echo -e "\033[1;33mKernel: \033[1;37m$(uname -s)"
echo -e "\033[1;33mKernel Release: \033[1;37m$(uname -r)"
if [ -f /etc/os-release ]
then
devlike=$(cat /etc/os-release |grep LIKE |awk -F = {'print $2'})
echo -e "\033[1;33mDerivado del SO: \033[1;37m$devlike"
echo ""
fi
else
system=$(cat /etc/issue.net)
echo -e "\033[1;31m• \033[1;32mSISTEMA OPERATIVO\033[1;31m •\033[0m"
echo ""
echo -e "\033[1;33mNombre: \033[1;37m$system"
echo ""
fi

if [ -f /proc/cpuinfo ]
then
uso=$(top -bn1 | awk '/Cpu/ { cpu = "" 100 - $8 "%" }; END { print cpu }')
echo -e "\033[1;31m• \033[1;32mPROCESADOR\033[1;31m •\033[0m"
echo ""
modelo=$(cat /proc/cpuinfo |grep "model name" |uniq |awk -F : {'print $2'})
cpucores=$(grep -c cpu[0-9] /proc/stat)
cache=$(cat /proc/cpuinfo |grep "cache size" |uniq |awk -F : {'print $2'})
echo -e "\033[1;33mModelo:\033[1;37m$modelo"
echo -e "\033[1;33mNúcleos:\033[1;37m $cpucores"
echo -e "\033[1;33mCaché:\033[1;37m$cache"
echo -e "\033[1;33mArquitectura: \033[1;37m$(uname -p)"
echo -e "\033[1;33mUtilización: \033[37m$uso"
echo ""
else
echo -e "\033[1;32mPROCESADOR\033[0m"
echo ""
echo "No fue posible obtener la información"
fi

if free 1>/dev/null 2>/dev/null
then
ram1=$(free -h | grep -i mem | awk {'print $2'})
ram2=$(free -h | grep -i mem | awk {'print $4'})
ram3=$(free -h | grep -i mem | awk {'print $3'})
usoram=$(free -m | awk 'NR==2{printf "%.2f%%\t\t", $3*100/$2 }')

echo -e "\033[1;31m• \033[1;32mMEMORIA RAM\033[1;31m •\033[0m"
echo ""
echo -e "\033[1;33mTotal: \033[1;37m$ram1"
echo -e "\033[1;33mEn uso: \033[1;37m$ram3"
echo -e "\033[1;33mLibre: \033[1;37m$ram2"
echo -e "\033[1;33mUtilización: \033[37m$usoram"
echo ""
else
echo -e "\033[1;32mMEMORIA RAM\033[0m"
echo ""
echo "No fue posible obtener la información"
fi
echo -e "\033[1;36m============================================================\033[0m"
echo -e "\033[1;32m• \033[1;37mPUERTOS Y SERVICIOS EN LÍNEA\033[1;32m •\033[0m"
echo -e "\033[1;36m------------------------------------------------------------\033[0m"
printf "  \033[1;33m%-12s %-12s %-20s\033[0m\n" "PROTO" "PUERTO" "SERVICIO / PROCESO"
echo -e "  \033[1;30m------------------------------------------------\033[0m"

# TCP Ports
ss -tlpn 2>/dev/null | awk 'NR>1 {print $4, $6, $7}' | while read -r local peer proc; do
    port=$(echo "$local" | awk -F: '{print $NF}')
    pname=$(echo "$proc" | grep -oE '"[^"]+"' | head -1 | tr -d '"')
    [[ -z "$pname" ]] && pname="Desconocido"
    [[ "$port" =~ ^[0-9]+$ ]] && printf "  \033[1;32m%-12s\033[0m \033[1;37m%-12s\033[0m \033[1;36m%-20s\033[0m\n" "TCP" "$port" "$pname"
done

# UDP Ports (SlowDNS, UDP Custom, Hysteria, BadVPN)
ss -ulpn 2>/dev/null | awk 'NR>1 {print $4, $6, $7}' | while read -r local peer proc; do
    port=$(echo "$local" | awk -F: '{print $NF}')
    pname=$(echo "$proc" | grep -oE '"[^"]+"' | head -1 | tr -d '"')
    [[ -z "$pname" ]] && pname="Desconocido"
    [[ "$port" =~ ^[0-9]+$ ]] && printf "  \033[1;33m%-12s\033[0m \033[1;37m%-12s\033[0m \033[1;36m%-20s\033[0m\n" "UDP" "$port" "$pname"
done
echo -e "\033[1;36m============================================================\033[0m"
echo ""
echo -e "\033[1;37m* \033[1;33mPresione Enter para continuar...\033[0m"
read -r _
