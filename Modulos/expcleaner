#!/bin/bash
# lang=es expcleaner

NC='\033[0m'
WHITE='\033[1;37m'
GREEN='\033[1;32m'
RED='\033[1;31m'
YELLOW='\033[1;33m'
CYAN='\033[1;38;2;76;228;255m'

datenow=$(date +%s)

exp_line() {
	echo -e "${CYAN}============================================================${NC}"
}

exp_dash() {
	echo -e "${WHITE}------------------------------------------------------------${NC}"
}

remove_ovp() {
	local user="$1" GROUPNAME
	[[ -e /etc/debian_version ]] && GROUPNAME=nogroup
	cd /etc/openvpn/easy-rsa/ || return
	./easyrsa --batch revoke "$user"
	./easyrsa gen-crl
	rm -rf "pki/reqs/$user.req" "pki/private/$user.key" "pki/issued/$user.crt"
	rm -rf /etc/openvpn/crl.pem
	cp /etc/openvpn/easy-rsa/pki/crl.pem /etc/openvpn/crl.pem
	chown nobody:$GROUPNAME /etc/openvpn/crl.pem
	[[ -e "$HOME/$user.ovpn" ]] && rm "$HOME/$user.ovpn" >/dev/null 2>&1
	[[ -e "/var/www/html/openvpn/$user.zip" ]] && rm "/var/www/html/openvpn/$user.zip" >/dev/null 2>&1
} >/dev/null 2>&1

exp_is_script_user() {
	local user="$1"
	[[ "$user" =~ ^(nobody|systemd-|polkitd|messagebus|daemon|bin|sys|sync|games|man|lp|mail|news|uucp|proxy|www-data|backup|list|irc|gnats|_apt)$ ]] && return 1
	[[ -e "/etc/SSHPlus/senha/$user" ]] && return 0
	[[ -f "$HOME/usuarios.db" ]] && grep -qw "$user" "$HOME/usuarios.db" && return 0
	return 1
}

exp_user_date() {
	local user="$1" raw
	raw="$(chage -l "$user" 2>/dev/null | awk -F: '/Account expires|La cuenta caduca|Cuenta expira|conta expira/ {gsub(/^ +/,"",$2); print $2; exit}')"
	[[ -z "$raw" ]] && raw="$(chage -l "$user" 2>/dev/null | grep -iE 'expires|caduca|expira' | head -1 | awk -F: '{gsub(/^ +/,"",$2); print $2}')"
	echo "$raw"
}

clear
exp_line
echo -e "${CYAN}                   ELIMINAR CADUCADOS${NC}"
exp_line
printf "${WHITE}%-18s %-15s %-18s %s${NC}\n" "Usuario" "Fecha" "Estado" "Accion"
exp_dash

deleted=0
for user in $(awk -F: '$3 >= 1000 && $1 != "nobody" {print $1}' /etc/passwd | sort); do
	exp_is_script_user "$user" || continue
	expdate="$(exp_user_date "$user")"
	[[ -z "$expdate" || "$expdate" =~ ^(never|nunca)$ ]] && continue
	datanormal="$(date -d "$expdate" '+%d/%m/%Y' 2>/dev/null)"
	expsec="$(date +%s --date="$expdate" 2>/dev/null)"
	[[ -z "$datanormal" || -z "$expsec" ]] && continue
	if [[ "$datenow" -gt "$expsec" ]]; then
		status="VENCIDO"
		action="ELIMINADO"
		pkill -f "$user" >/dev/null 2>&1 || true
		userdel --force "$user" >/dev/null 2>&1 || true
		if [[ -f "$HOME/usuarios.db" ]]; then
			grep -v "^$user[[:space:]]" "$HOME/usuarios.db" > /tmp/sshplus_users.$$ && cat /tmp/sshplus_users.$$ > "$HOME/usuarios.db"
			rm -f /tmp/sshplus_users.$$
		fi
		[[ -e /etc/openvpn/server.conf ]] && remove_ovp "$user"
		deleted=$((deleted + 1))
	else
		status="VIGENTE"
		action="NO ELIMINADO"
	fi
	printf "${YELLOW}%-18s${NC} ${WHITE}%-15s ${GREEN}%-18s${NC} ${WHITE}%s${NC}\n" "$user" "$datanormal" "$status" "$action"
done

echo "$deleted" > /etc/SSHPlus/Exp
exp_line
