def list_servers():
    print_banner()
    try:
        req = urllib.request.Request(f"{API_URL}/api/v1/servers/stats")
        with urllib.request.urlopen(req, timeout=5) as resp:
            stats = json.loads(resp.read().decode("utf-8"))

        print(f"{C_BOLD}🌍 RESUMEN DE SERVIDORES POR PAÍS ({stats.get('version', '')}):{C_RESET}")
        print(f"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
