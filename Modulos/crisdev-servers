    print(f"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    
    if health:
        print(f"  🤖 {C_BOLD}Servidor API REST:{C_RESET}       {C_GREEN}ACTIVO / ONLINE [✔]{C_RESET} (Puerto 8088)")
        print(f"  📦 {C_BOLD}Versión Publicada:{C_RESET}       {C_CYAN}{health.get('version_code', 'N/A')}{C_RESET}")
        print(f"  🌐 {C_BOLD}Servidores Totales:{C_RESET}      {C_GREEN}{health.get('total_servers', 0)} Servidores Activos{C_RESET}")
        print(f"  🆓 {C_BOLD}Servidores Free:{C_RESET}         {C_CYAN}{health.get('total_free', 0)} Gratuitos{C_RESET}")
        print(f"  👑 {C_BOLD}Servidores VIP/Premium:{C_RESET}  {C_MAGENTA}{health.get('total_premium', 0)} Premium{C_RESET}")
        print(f"  🗺️ {C_BOLD}Países Soportados:{C_RESET}       {C_YELLOW}{health.get('total_countries', 0)} Países{C_RESET}")
        print(f"  ⏱️ {C_BOLD}Uptime del Daemon:{C_RESET}       {health.get('uptime_seconds', 0)} segundos")
    else:
        print(f"  🤖 {C_BOLD}Servidor API REST:{C_RESET}       {C_RED}DETENIDO / OFFLINE [✖]{C_RESET}")

    print(f"  🗄️ {C_BOLD}Base de Datos SQLite:{C_RESET}    {C_GREEN}Modo WAL [✔]{C_RESET} ({db_size} KB)")
    print(f"  📁 {C_BOLD}Ruta de Base de Datos:{C_RESET}   <code>{DB_PATH}</code>")
    
