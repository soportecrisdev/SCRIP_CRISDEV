        for code, count in by_c.items():
            print(f"  🚩 {C_BOLD}{code.upper()}:{C_RESET}  {C_GREEN}{count} servidores activos{C_RESET}")
        print(f"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
        print(f"  {C_CYAN}Total General: {stats.get('total_servers', 0)} servidores en {stats.get('total_countries', 0)} países ({stats.get('total_free', 0)} Free / {stats.get('total_premium', 0)} VIP).{C_RESET}\n")
    except Exception as e:
