def get_api_health():
    try:
        req = urllib.request.Request(f"{API_URL}/api/v1/health")
        with urllib.request.urlopen(req, timeout=3) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception:
        return None

