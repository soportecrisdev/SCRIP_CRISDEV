#!/bin/bash
# lang=es changepass v3-2026
database="/root/usuarios.db"
SSHPLUS_CYAN=$'\033[38;2;76;228;255m'
SSHPLUS_NUM=$'\033[1;38;2;0;255;127m'

line() { echo -e "${SSHPLUS_CYAN}============================================================\033[0m"; }
title() {
	local text="$1" cols pad
	cols="$(tput cols 2>/dev/null || echo 60)"
	[[ "$cols" =~ ^[0-9]+$ ]] || cols=60
	[[ "$cols" -gt 60 ]] && cols=60
	[[ "$cols" -lt 40 ]] && cols=40
	[[ ${#text} -gt "$cols" ]] && text="${text:0:cols}"
	pad=$(( (cols - ${#text}) / 2 ))
	[[ "$pad" -lt 0 ]] && pad=0
	printf '%*s%b\033[1m%s\033[0m\n' "$pad" "" "$SSHPLUS_CYAN" "$text"
}

valid_sshplus_user() {
	local user="$1" uid
	[[ -z "$user" || "$user" == "nobody" || "$user" == systemd-* || "$user" == "_"* ]] && return 1
	uid="$(getent passwd "$user" 2>/dev/null | awk -F: '{print $3}')"
	[[ "$uid" =~ ^[0-9]+$ && "$uid" -ge 1000 ]]
}

show_error() {
	echo ""
	tput setaf 7; tput setab 1; tput bold
	echo "$1"
	tput sgr0
	echo ""
	exit 1
}

clear
[[ -f "$database" ]] || show_error "Archivo $database no encontrado"

line
title "CAMBIAR CONTRASENA DEL USUARIO"
line
echo -e "${SSHPLUS_CYAN}\033[1mUSUARIOS:                   CONTRASENA:\033[0m"
echo -e "${SSHPLUS_CYAN}\033[1m------------------------------------------------------------\033[0m"

i=0
unset _userPass
while read -r user _limit _rest; do
	[[ -z "$user" ]] && continue
	valid_sshplus_user "$user" || continue
	i=$((i + 1))
	if [[ -e "/etc/SSHPlus/senha/$user" ]]; then
		password="$(cat "/etc/SSHPlus/senha/$user")"
	else
		password="Null"
	fi
	printf '%b[%s]\033[0m \033[1;37m> %-25s %s\033[0m\n' "$SSHPLUS_NUM" "$i" "$user" "$password"
	_userPass+="\n${i}:${user}"
done < "$database"

if [[ "$i" -eq 0 ]]; then
	echo -e "\033[1;33mNo hay usuarios SSH creados por la script.\033[0m"
	echo ""
	echo -ne "\033[1;37m* \033[1;33mEnter para volver\033[1;31m"
	read enter
	exit 0
fi
line
echo -e "${SSHPLUS_NUM}[0]\033[0m \033[1;37m> CANCELAR\033[0m"
line

echo -ne "\033[1;32mOpcion\033[1;33m: \033[0m"; read -r option
[[ "$option" == "0" || "$option" == "00" ]] && { echo -e "\033[1;33mOperación cancelada.\033[0m"; sleep 1; exit 0; }
[[ -z "$option" ]] && show_error "Campo vacio o no valido."

user="$(echo -e "${_userPass}" | grep -E "^${option}:" | cut -d: -f2)"
[[ -z "$user" ]] && show_error "Opción no valida. Seleccione un numero de la lista."
getent passwd "$user" >/dev/null 2>&1 || show_error "El usuario $user no existe."

echo -ne "\n\033[1;32mNueva contrasena para el usuario \033[1;33m$user\033[1;37m: "; read -r password
sizepass=${#password}
[[ "$sizepass" -ge 4 ]] || show_error "Contrasena vacia o no valida (minimo 4 caracteres)."

if ps x | grep "$user" | grep -v grep | grep -v pt >/tmp/rem 2>/dev/null && grep -q "$user" /tmp/rem 2>/dev/null; then
	echo ""
	tput setaf 7; tput setab 4; tput bold
	echo "Usuario conectado. Desconectando..."
	tput sgr0
	pkill -f "$user"
fi

echo "$user:$password" | chpasswd
mkdir -p /etc/SSHPlus/senha
echo "$password" > "/etc/SSHPlus/senha/$user"
[[ -x /bin/hysteria-menu ]] && /bin/hysteria-menu --sync >/dev/null 2>&1 || true

tput setaf 7; tput setab 4; tput bold
echo ""
echo "La contrasena del usuario $user se cambio a: $password"
echo ""
tput sgr0
echo ""
echo -ne "\033[1;37m* \033[1;33mEnter para continuar\033[1;31m"
read enter
exit 0
