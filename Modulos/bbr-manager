#!/usr/bin/env bash
# ==============================================================================
#  TCP TWEAKER & BBR ACCELERATOR — Optimizador de Red para SSH-CRIS / SSH-PLUS
# ==============================================================================

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
WHITE='\033[1;37m'
NC='\033[0m'
SCOLOR='\033[0m'
SSHPLUS_NUM=$'\033[1;38;2;0;255;127m'
SSHPLUS_CYAN=$'\033[1;38;2;76;228;255m'
SSHPLUS_DARK_GREEN=$'\033[0;32m'

SYSCTL_BBR_FILE="/etc/sysctl.d/99-bbr-crisdev.conf"
SYSCTL_MAIN="/etc/sysctl.conf"

bbr_resize() {
    SSHPLUS_COLS="$(tput cols 2>/dev/null || echo 80)"
    [[ ! "$SSHPLUS_COLS" =~ ^[0-9]+$ ]] && SSHPLUS_COLS=80
    SSHPLUS_IW=60
    [[ "$SSHPLUS_COLS" -lt 62 ]] && SSHPLUS_IW=$(( SSHPLUS_COLS - 2 ))
    [[ "$SSHPLUS_IW" -lt 42 ]] && SSHPLUS_IW=42
}

bbr_line() {
    local i
    bbr_resize
    printf '%b' "$SSHPLUS_CYAN"
    for ((i=0;i<SSHPLUS_IW;i++)); do printf '='; done
    printf '\033[0m\n'
}

bbr_title() {
    local title="$1" pad
    bbr_resize
    bbr_line
    pad=$(( (SSHPLUS_IW - ${#title}) / 2 ))
    [[ "$pad" -lt 0 ]] && pad=0
    printf '%*s%b%s\033[0m\n' "$pad" "" "$SSHPLUS_CYAN" "$title"
    bbr_line
}

bbr_opt() {
    local n="${1#0}"
    [[ -z "$n" ]] && n="0"
    printf '%b[%s]\033[0m \033[1;37m>\033[0m \033[1;37m%s\033[0m %b\n' "$SSHPLUS_NUM" "$n" "$2" "$3"
}

pause_bbr() {
    echo ""
    echo -e "\033[1;37m* \033[1;33mPresione Enter para continuar...\033[0m"
    read -r _
}

get_current_cc() {
    sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "cubic"
}

get_current_qdisc() {
    sysctl -n net.core.default_qdisc 2>/dev/null || echo "fq_codel"
}

is_bbr_active() {
    local cc; cc=$(get_current_cc)
    [[ "$cc" == "bbr" ]]
}

apply_bbr_optimization() {
    clear
    bbr_title "ACTIVANDO ACELERADOR TCP BBR & RED"
    echo -e "${YELLOW}[1/4] Comprobando soporte del módulo BBR en el Kernel...${NC}"
    modprobe tcp_bbr 2>/dev/null || true

    echo -e "${YELLOW}[2/4] Generando directivas sysctl de alta velocidad (64MB Buffers)...${NC}"
    mkdir -p /etc/sysctl.d
    cat > "$SYSCTL_BBR_FILE" << 'EOF'
# ==============================================================================
#  SSH-CRIS / HTTP CONEXIÓN — TCP BBR & BUFFER OPTIMIZER (sysctl)
# ==============================================================================
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr

# Buffers de Socket TCP y UDP de alta velocidad (64 MB)
net.core.rmem_max = 67108864
net.core.wmem_max = 67108864
net.core.rmem_default = 262144
net.core.wmem_default = 262144
net.core.optmem_max = 2048576

# Rangos de memoria TCP (min, default, max)
net.ipv4.tcp_rmem = 4096 87380 67108864
net.ipv4.tcp_wmem = 4096 65536 67108864
net.ipv4.udp_rmem_min = 16384
net.ipv4.udp_wmem_min = 16384

# Optimizaciones de Latencia y Red
net.ipv4.tcp_window_scaling = 1
net.ipv4.tcp_timestamps = 1
net.ipv4.tcp_sack = 1
net.ipv4.tcp_dsack = 1
net.ipv4.tcp_mtu_probing = 1
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_slow_start_after_idle = 0
net.ipv4.tcp_no_metrics_save = 1
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_fin_timeout = 15

# Conexiones simultáneas y cola de red
net.core.netdev_max_backlog = 100000
net.core.somaxconn = 65535
net.ipv4.tcp_max_syn_backlog = 65535
net.ipv4.tcp_max_tw_buckets = 2000000
fs.file-max = 2097152
EOF

    # Eliminar bloques antiguos de sysctl.conf para evitar conflictos
    sed -i '/#PH56/,+10d' "$SYSCTL_MAIN" 2>/dev/null || true

    echo -e "${YELLOW}[3/4] Aplicando parámetros al núcleo del sistema en tiempo real...${NC}"
    sysctl -p "$SYSCTL_BBR_FILE" >/dev/null 2>&1 || sysctl --system >/dev/null 2>&1 || true

    echo -e "${YELLOW}[4/4] Verificando estado final...${NC}"
    local new_cc; new_cc=$(get_current_cc)
    local new_qd; new_qd=$(get_current_qdisc)

    echo ""
    bbr_line
    if [[ "$new_cc" == "bbr" ]]; then
        echo -e "\033[1;32m✔ ¡TCP BBR activado y funcionando al 100%! 🚀\033[0m"
        echo -e "${WHITE}Algoritmo Congestión:${NC} \033[1;33m${new_cc^^}\033[0m"
        echo -e "${WHITE}Disciplina de Colas :${NC} \033[1;33m${new_qd}\033[0m"
        echo -e "${WHITE}Buffers de Red      :${NC} \033[1;32m64 MB (Ultra Fast)\033[0m"
    else
        echo -e "\033[1;33m⚠ Los parámetros se aplicaron, pero el kernel reporta: ${new_cc}\033[0m"
        echo -e "\033[1;37m(En algunas VPS basadas en OpenVZ el kernel no permite cambiar el algoritmo)\033[0m"
    fi
    bbr_line
    pause_bbr
}

restore_default_tcp() {
    clear
    bbr_title "RESTAURAR CONFIGURACIÓN TCP POR DEFECTO"
    echo -ne "${RED}¿Desea eliminar la aceleración BBR y volver a la configuración estándar? [s/N]: ${NC}"
    read -r conf
    if [[ ! "$conf" =~ ^[sS]$ ]]; then
        return
    fi

    rm -f "$SYSCTL_BBR_FILE"
    sysctl -w net.ipv4.tcp_congestion_control=cubic >/dev/null 2>&1 || true
    sysctl -w net.core.default_qdisc=fq_codel >/dev/null 2>&1 || true
    sysctl -p "$SYSCTL_MAIN" >/dev/null 2>&1 || true

    echo -e "\n\033[1;32m✔ Configuración TCP restaurada a los valores de fábrica.\033[0m"
    pause_bbr
}

view_tcp_diagnostic() {
    clear
    bbr_title "DIAGNÓSTICO Y ESTADO DE RED TCP"
    local cc; cc=$(get_current_cc)
    local qd; qd=$(get_current_qdisc)
    local rmem; rmem=$(sysctl -n net.core.rmem_max 2>/dev/null || echo "N/A")
    local wmem; wmem=$(sysctl -n net.core.wmem_max 2>/dev/null || echo "N/A")
    local fo; fo=$(sysctl -n net.ipv4.tcp_fastopen 2>/dev/null || echo "0")
    local mtu_p; mtu_p=$(sysctl -n net.ipv4.tcp_mtu_probing 2>/dev/null || echo "0")

    printf "  \033[1;32m%-26s\033[0m \033[1;37m%s\033[0m\n" "Control de Congestión:" "${cc^^}"
    printf "  \033[1;32m%-26s\033[0m \033[1;37m%s\033[0m\n" "Disciplina de Colas (Qdisc):" "$qd"
    printf "  \033[1;32m%-26s\033[0m \033[1;37m%s\033[0m\n" "Buffer Máximo Lectura:" "$rmem bytes"
    printf "  \033[1;32m%-26s\033[0m \033[1;37m%s\033[0m\n" "Buffer Máximo Escritura:" "$wmem bytes"
    printf "  \033[1;32m%-26s\033[0m \033[1;37m%s\033[0m\n" "TCP FastOpen:" "$fo"
    printf "  \033[1;32m%-26s\033[0m \033[1;37m%s\033[0m\n" "TCP MTU Probing:" "$mtu_p"

    echo ""
    echo -e "${YELLOW}Módulos de congestión disponibles en el Kernel:${NC}"
    sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null || echo "cubic reno"
    echo ""
    bbr_line
    pause_bbr
}

fun_tcptweaker() {
    while true; do
        clear
        local bbr_status="${RED}DESACTIVADO [x]${NC}"
        local cur_cc; cur_cc=$(get_current_cc)
        local cur_qd; cur_qd=$(get_current_qdisc)

        if is_bbr_active; then
            bbr_status="${GREEN}ACTIVADO (BBR + FQ) [o]${NC}"
        fi

        bbr_title "TCP TWEAKER & BBR SPEED ACCELERATOR"
        echo -e "  ${WHITE}ESTADO DE ACELERACIÓN : ${bbr_status}"
        echo -e "  ${WHITE}ALGORITMO ACTUAL      : ${YELLOW}${cur_cc^^}${NC}"
        echo -e "  ${WHITE}COLA DE RED (QDISC)   : ${GREEN}${cur_qd}${NC}"
        bbr_line
        bbr_opt "1" "ACTIVAR TCP BBR + BUFFERS 64MB (RECOMENDADO)"
        bbr_opt "2" "RESTAURAR VALORES DE FÁBRICA (CUBIC)"
        bbr_opt "3" "VER DIAGNÓSTICO COMPLETO DE RED"
        bbr_opt "0" "VOLVER"
        bbr_line
        echo -ne "${SSHPLUS_CYAN}Opción:${SCOLOR} "
        read -r opc
        case "$opc" in
            1|01) apply_bbr_optimization ;;
            2|02) restore_default_tcp ;;
            3|03) view_tcp_diagnostic ;;
            0|00) exit 0 ;;
            *)
                echo -e "\033[1;31mOpción no válida!\033[0m"
                sleep 1
                ;;
        esac
    done
}

fun_tcptweaker
