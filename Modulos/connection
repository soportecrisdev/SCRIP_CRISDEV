	# Al apagar SOCKS SSH: mismo proxy.py que una instalación nueva (Install/list: wget Modulos/proxy.py).
	fun_proxy_socks_reset_defaults() {
		local _pf=/etc/SSHPlus/proxy.py
		local SSHPLUS_GH_USER_REPO="${SSHPLUS_GH_USER_REPO:-soportecrisdev/SCRIP_CRISDEV}"
		case "${SSHPLUS_GH_USER_REPO}" in
		usuario/tu-repo|tu_usuario/tu_repo) SSHPLUS_GH_USER_REPO="soportecrisdev/SCRIP_CRISDEV" ;;
		esac
		local SSHPLUS_GH_BRANCH="${SSHPLUS_GH_BRANCH:-main}"
		local SSHPLUS_RAW="https://raw.githubusercontent.com/${SSHPLUS_GH_USER_REPO}/${SSHPLUS_GH_BRANCH}"
		local _url="${SSHPLUS_RAW}/Modulos/proxy.py"
		local _dl=0
		mkdir -p /etc/SSHPlus
		rm -f "${_pf}.new"
		# Solo sustituir si el archivo es Python válido (evita HTML 404/red y proxy.py roto al reactivar [1]).
		_fun_proxy_socks_new_ok() {
			[[ -s "${_pf}.new" ]] || return 1
			grep -q 'import socket' "${_pf}.new" || return 1
			grep -q 'class Server' "${_pf}.new" || return 1
			grep -qiE '<!DOCTYPE|<html' "${_pf}.new" && return 1
			"${SSHPLUS_PY}" -c "import ast; ast.parse(open(r'''${_pf}.new''', encoding='utf-8', errors='replace').read())" 2>/dev/null || return 1
			return 0
		}
		if command -v wget >/dev/null 2>&1; then
			if wget -qO "${_pf}.new" "$_url" && _fun_proxy_socks_new_ok; then
				mv -f "${_pf}.new" "$_pf" && _dl=1
			fi
		fi
		if [[ "$_dl" != '1' ]] && command -v curl >/dev/null 2>&1; then
			if curl -fsSL -o "${_pf}.new" "$_url" && _fun_proxy_socks_new_ok; then
				mv -f "${_pf}.new" "$_pf" && _dl=1
			fi
		fi
		rm -f "${_pf}.new"
		if [[ "$_dl" = '1' ]]; then
			chmod +x "$_pf" 2>/dev/null || true
			return 0
		fi
		[[ ! -f "$_pf" ]] && return 0
		"${SSHPLUS_PY}" - "$_pf" <<'PY' 2>/dev/null || true
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])
if not path.is_file():
    sys.exit(0)
text = path.read_text(encoding="utf-8", errors="replace")

def rep_line(t, name, rhs):
    pat = r"^" + re.escape(name) + r" = .*$"
    if not re.search(pat, t, flags=re.MULTILINE):
        return t
    return re.sub(pat, name + " = " + rhs, t, count=1, flags=re.MULTILINE)

text = rep_line(text, "MSG", '""')
text = rep_line(text, "COR", "'<font color=\"null\">'")
text = rep_line(text, "FTAG", '"</font>"')
text = rep_line(text, "DEFAULT_HOST", '"0.0.0.0:22"')
resp = (
    "RESPONSE = (\n"
    '    b"HTTP/1.1 200 OK\\r\\n"\n'
    '    b"Content-Length: 0\\r\\n"\n'
    '    b"\\r\\n"\n'
    '    b"HTTP/1.1 200 Connection Established\\r\\n"\n'
    '    b"\\r\\n"\n'
    ")\n"
)
if re.search(r"^RESPONSE = \(", text, flags=re.MULTILINE):
    text = re.sub(r"^RESPONSE = \(.*?\n\)\s*", resp, text, count=1, flags=re.MULTILINE | re.DOTALL)
elif re.search(r"^RESPONSE = ", text, flags=re.MULTILINE):
    text = re.sub(r"^RESPONSE = .*$", resp.rstrip("\n"), text, count=1, flags=re.MULTILINE)
path.write_text(text, encoding="utf-8")
