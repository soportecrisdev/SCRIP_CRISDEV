				_hcr_pts="$(awk -F'|' '{print $1}' /etc/hcr-server/ports.conf 2>/dev/null | xargs)"
			fi
			if pgrep -f 'hcr-server' >/dev/null 2>&1 || [[ -n "${_hcr_pts// }" ]]; then
				echo -e "\033[1;32mSERVICIO: \033[1;33mHCR RELAY \033[1;32mPUERTO: \033[1;37m${_hcr_pts:-N/A}"
				hcrsts="\033[1;32mo "
			else
				hcrsts="\033[1;31mx "
			fi
			local _udpc_pt=""
			if [[ -f /opt/udp-custom/config.json ]]; then
				_udpc_pt="$(grep -oE '"bind"[[:space:]]*:[[:space:]]*"[^"]+"' /opt/udp-custom/config.json 2>/dev/null | grep -oE '[0-9]+' | head -1)"
			fi
			if systemctl is-active --quiet udp-custom 2>/dev/null || pgrep -x udp-custom >/dev/null 2>&1 || [[ -n "${_udpc_pt// }" ]]; then
				echo -e "\033[1;32mSERVICIO: \033[1;33mUDP CUSTOM \033[1;32mPUERTO: \033[1;37m${_udpc_pt:-7100}/udp"
				udpcsts="\033[1;32mo "
			else
				udpcsts="\033[1;31mx "
			fi
			sshplus_line
			sshplus_opt_pair "1" "OPENSSH" "$sts6" "10" "OPENVPN" "$sts5"
			sshplus_opt_pair "2" "PROXY SOCKS" "$sts4" "11" "WEBSOCKET-CORRECTOR" "$wssts"
			sshplus_opt_pair "3" "SSL TUNNEL" "$sts3" "12" "SSLH MULTIPLEX" "$sts7"
			sshplus_opt_pair "4" "DROPBEAR" "$sts2" "13" "SQUID PROXY" "$sts1"
			sshplus_opt_pair "5" "V2RAY" "$xv2ray" "14" "CHISEL" "$sts8"
			sshplus_opt_pair "6" "SLOWDNS" "$sts9" "15" "PANEL WEB V2RAY" ""
			sshplus_opt_pair "7" "HYSTERIA v1" "$hysteriasts" "16" "BHTTP (BHP1/TLS)" "$bhttpsts"
			sshplus_opt_pair "8" "TROJAN-GO" "$trojansts" "17" "HCR RELAY" "$hcrsts"
			sshplus_opt_pair "9" "BADVPN" "$badsts" "18" "UDP CUSTOM" "$udpcsts"
			sshplus_opt "0" "VOLVER"
			sshplus_line
			tput civis
			echo -ne "${SSHPLUS_CYAN}Opcion:${SCOLOR} ";
			read x
			tput cnorm
			clear
			case $x in
			1 | 01)
			fun_openssh
			;;
			2 | 02)
			fun_socks
			;;
			3 | 03)
			inst_ssl
			;;
			4 | 04)
			fun_drop
			;;
			5 | 05)
			v2raymanager
			exit
			;;
			6 | 06) 
			slowdnsmanager
			;;
			7 | 07)
			hysteria-menu
			;;
			8 | 08)
			trojan-go
			;;
			9 | 09)
			menub
			;;
			10 | 10)
			fun_openvpn
			;;
			11 | 11)
			websocket.sh
			;;
			12 | 12)
			fun_sslh
			;;
			13 | 13)
			fun_squid
			;;
			14 | 14)
			fun_chisel
			;;
			15 | 15)
			clear
			v2raypanel
			;;
			16 | 16)
			if [[ -x /usr/local/bin/ssh-cris ]]; then
				/usr/local/bin/ssh-cris
			elif [[ -x /bin/menu ]]; then
				/bin/menu
			fi
			;;
			17 | 17)
			if [[ -x /bin/hcr-manager || -x /usr/bin/hcr-manager ]]; then
				hcr-manager
			elif [[ -f /opt/ssh-cris/Modulos/hcr-manager ]]; then
				bash /opt/ssh-cris/Modulos/hcr-manager
			else
				clear
				echo -e "\033[1;32mDescargando e iniciando HCR Manager...\033[0m"
				curl -fsSL https://raw.githubusercontent.com/soportecrisdev/SCRIP_CRISDEV/main/Modulos/hcr-manager -o /bin/hcr-manager 2>/dev/null
				chmod +x /bin/hcr-manager 2>/dev/null || true
				hcr-manager
			fi
			;;
			18 | 18)
			if [[ -x /bin/udp-custom-manager || -x /usr/bin/udp-custom-manager ]]; then
				udp-custom-manager
			elif [[ -f /opt/ssh-cris/Modulos/udp-custom-manager ]]; then
				bash /opt/ssh-cris/Modulos/udp-custom-manager
			else
				clear
				echo -e "\033[1;32mDescargando e iniciando UDP Custom Manager...\033[0m"
				curl -fsSL https://raw.githubusercontent.com/soportecrisdev/SCRIP_CRISDEV/main/Modulos/udp-custom-manager -o /bin/udp-custom-manager 2>/dev/null
				chmod +x /bin/udp-custom-manager 2>/dev/null || true
				udp-custom-manager
			fi
			;;
			0 | 00)
			printf '\033c\033[3J\033[H\033[2J'
			exec /bin/menu
			;;
			*)
			echo -e "\033[1;31mOpcion no valida!\033[0m"
			sleep 2
			;;
			esac
		done
	}
	fun_conexao
}
