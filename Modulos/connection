	# Solo servicios TCP en escucha reales (ss/netstat); sin puertos “por defecto” inventados
	fun_ws_pick_redirect() {
		local porta_ws="$1"
		local pad d left ch manualp n i pr line
		local -a _lbl _prt
		local -A _seenp

		_ws_append() {
			local L="$1" P="$2"
			[[ -z "$P" || ! "$P" =~ ^[0-9]+$ ]] && return
			[[ "$P" == "$porta_ws" ]] && return
			[[ -n "${_seenp[$P]}" ]] && return
			_seenp[$P]=1
			_lbl+=("$L")
			_prt+=("$P")
		}

		pr=$(netstat -nplt 2>/dev/null | grep -E 'python3|/python' | awk '{print $4}' | grep -oE '[0-9]+$' | head -1)
		_ws_append "python3" "$pr"

		if command -v ss >/dev/null 2>&1; then
			while IFS= read -r line; do
				[[ "$line" != *LISTEN* ]] && continue
				[[ "$line" != *sshd* ]] && continue
				pr=$(echo "$line" | awk '{print $4}' | grep -oE '[0-9]+$')
				_ws_append "sshd" "$pr"
				break
			done < <(ss -tlnp 2>/dev/null)
			while IFS= read -r line; do
				[[ "$line" != *LISTEN* ]] && continue
				echo "$line" | grep -qE 'v2ray|xray' || continue
				pr=$(echo "$line" | awk '{print $4}' | grep -oE '[0-9]+$')
				_ws_append "v2ray" "$pr"
			done < <(ss -tlnp 2>/dev/null)
			while IFS= read -r line; do
				[[ "$line" != *LISTEN* ]] && continue
				echo "$line" | grep -qE 'openvpn' || continue
				pr=$(echo "$line" | awk '{print $4}' | grep -oE '[0-9]+$')
				_ws_append "openvpn" "$pr"
				break
			done < <(ss -tlnp 2>/dev/null)
		else
			pr=$(netstat -nplt 2>/dev/null | grep sshd | awk '{print $4}' | grep -oE '[0-9]+$' | head -1)
			_ws_append "sshd" "$pr"
			while IFS= read -r line; do
				echo "$line" | grep -qE 'v2ray|xray' || continue
				pr=$(echo "$line" | awk '{print $4}' | grep -oE '[0-9]+$')
				_ws_append "v2ray" "$pr"
			done < <(netstat -nplt 2>/dev/null)
			pr=$(netstat -nplt 2>/dev/null | grep openvpn | awk '{print $4}' | grep -oE '[0-9]+$' | head -1)
			_ws_append "openvpn" "$pr"
		fi

		WS_REDIR_PORT=""
		n=${#_prt[@]}
		while true; do
            clear
            sshplus_line
            echo -e "${SSHPLUS_CYAN}              CONFIGURAR WEBSOCKET (REDIRECCION)${SCOLOR}"
            sshplus_line
            echo -e "${SSHPLUS_DARK_GREEN}PUERTO WEBSOCKET (escucha):${SCOLOR} \033[1;37m${porta_ws}${SCOLOR}"
            sshplus_line
            echo -e "\033[1;37m        A QUE PUERTO REDIRIGIR EL TRAFICO?${SCOLOR}"
            sshplus_line
            if [[ "$n" -eq 0 ]]; then
                echo -e "\033[1;37mNo se detectaron listeners: python3, sshd, v2ray/xray, openvpn${SCOLOR}"
                echo -e "\033[1;37mUse [5] para escribir el puerto destino (127.0.0.1).${SCOLOR}"
            else
                for ((i = 0; i < n; i++)); do
                    left="[$((i + 1))] > ${_lbl[i]} "
                    pad=$((40 - ${#left} - ${#_prt[i]}))
                    ((pad < 2)) && pad=2
                    d=$(printf "%*s" "$pad" "" | tr " " ".")
                    echo -e "${SSHPLUS_NUM}[$((i + 1))]${SCOLOR} \033[1;37m> ${_lbl[i]} \033[1;33m${d}\033[1;37m${_prt[i]}${SCOLOR}"
                done
            fi
            sshplus_line
            echo -e "${SSHPLUS_NUM}[0]${SCOLOR} \033[1;37m> CANCELAR${SCOLOR}    ${SSHPLUS_NUM}[5]${SCOLOR} \033[1;37m> INGRESAR MANUALMENTE${SCOLOR}"
            sshplus_line
            echo ""
			echo -ne "${SSHPLUS_CYAN}Opcion:${SCOLOR} "
			read ch
			case "$ch" in
				0) return 1 ;;
				5)
					echo -ne "${SSHPLUS_CYAN}PUERTO DESTINO (127.0.0.1):${SCOLOR} \033[1;37m"
					read manualp
					[[ -z "$manualp" ]] && continue
					if [[ ! "$manualp" =~ ^[0-9]+$ ]]; then
						echo -e "\033[1;31mPuerto invalido\033[0m"
						sleep 2
						continue
					fi
					WS_REDIR_PORT="$manualp"
					break
					;;
				*)
					if [[ "$ch" =~ ^[0-9]+$ ]] && [[ "$ch" -ge 1 && "$ch" -le "$n" ]]; then
						WS_REDIR_PORT="${_prt[$((ch - 1))]}"
						break
					fi
					echo -e "\033[1;33mOpcion invalida\033[0m"
					sleep 1
					;;
			esac
		done
		[[ ! "$WS_REDIR_PORT" =~ ^[0-9]+$ ]] && return 1
		return 0
	}

	# Tras puerto + redirección: estado HTTP, encabezado extra y minibanner (MSG en wsproxy.py)
	fun_ws_apply_py_config() {
		local _redir="$1" _http="$2" _msg="$3" _post="$4"
		export WS_PATCH_REDIR="$_redir" WS_PATCH_HTTP="$_http"
		WS_PATCH_MSG_B64=$(printf '%s' "$_msg" | base64 2>/dev/null | tr -d '\n\r')
		WS_PATCH_POST_B64=$(printf '%s' "$_post" | base64 2>/dev/null | tr -d '\n\r')
		export WS_PATCH_MSG_B64 WS_PATCH_POST_B64
		python3 <<'PATCHWS' || return 1
import base64
import os
import pathlib
import re
import sys

path = pathlib.Path("/etc/SSHPlus/wsproxy.py")
if not path.is_file():
    sys.exit(1)
text = path.read_text(encoding="utf-8")
redir = os.environ["WS_PATCH_REDIR"]
http = os.environ["WS_PATCH_HTTP"]
msg = base64.b64decode(os.environ.get("WS_PATCH_MSG_B64", "")).decode("utf-8", errors="replace")
post = base64.b64decode(os.environ.get("WS_PATCH_POST_B64", "")).decode("latin1", errors="replace")

def rep_line(t, name, rhs):
    pat = r"^" + re.escape(name) + r" = .*$"
    if not re.search(pat, t, flags=re.MULTILINE):
        return None
    return re.sub(pat, name + " = " + rhs, t, count=1, flags=re.MULTILINE)

n = repr(f"127.0.0.1:{redir}")
t2 = rep_line(text, "DEFAULT_HOST", n)
if t2 is None:
    sys.exit(1)
text = t2
for _name, _rhs in (
    ("HTTP_STATUS", repr(http)),
    ("MSG", repr(msg)),
    ("POST_HEADER_RAW", repr(post)),
):
    _t = rep_line(text, _name, _rhs)
    if _t is None:
        sys.stderr.write("wsproxy.py: falta línea " + _name + " = (actualice wsproxy.py desde el repo)\n")
        sys.exit(1)
    text = _t
path.write_text(text, encoding="utf-8")
PATCHWS
	}

