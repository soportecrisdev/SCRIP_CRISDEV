cor1='\033[41;1;37m'
cor2='\033[44;1;37m'
scor='\033[0m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
SCOLOR='\033[0m'
SSHPLUS_NUM=$'\033[1;38;2;0;255;127m'
SSHPLUS_CYAN=$'\033[1;38;2;76;228;255m'
SSHPLUS_DARK_GREEN=$'\033[0;32m'
sshplus_resize() {
	SSHPLUS_COLS="$(tput cols 2>/dev/null || echo 80)"
	[[ ! "$SSHPLUS_COLS" =~ ^[0-9]+$ ]] && SSHPLUS_COLS=80
	if [[ "$SSHPLUS_COLS" -lt 58 ]]; then
		SSHPLUS_COMPACT=1
		SSHPLUS_IW=$(( SSHPLUS_COLS - 2 ))
		[[ "$SSHPLUS_IW" -lt 42 ]] && SSHPLUS_IW=42
		[[ "$SSHPLUS_IW" -gt 60 ]] && SSHPLUS_IW=60
	else
		SSHPLUS_COMPACT=0
		SSHPLUS_IW=60
	fi
}
sshplus_resize
sshplus_clear() {
	printf '\033c\033[3J\033[H\033[2J'
	sshplus_resize
}
clear() { sshplus_clear; }
sshplus_line() {
	local i
	printf '%b' "$SSHPLUS_CYAN"
	for ((i=0;i<SSHPLUS_IW;i++)); do printf '='; done
	printf '\033[0m\n'
}
sshplus_opt() {
	local n="${1#0}"
	[[ -z "$n" ]] && n="0"
	printf '%b[%s]\033[0m \033[1;37m>\033[0m \033[1;37m%s\033[0m %b\n' "$SSHPLUS_NUM" "$n" "$2" "$3"
}
sshplus_opt_cell() {
	local n="${1#0}" text="$2" st="$3" max="${4:-19}" cell num rest
	[[ -z "$n" ]] && n="0"
	printf -v num '[%s]' "$n"
	st="${st%"${st##*[![:space:]]}"}"
	[[ "${SSHPLUS_COMPACT:-0}" == 1 ]] && max=$(( SSHPLUS_IW - 13 ))
	[[ "$max" -lt 12 ]] && max=12
	text="${text:0:max}"
	printf -v rest ' > %-*s' "$max" "$text"
	printf '%b%s\033[0m\033[1;37m%s\033[0m%b' "$SSHPLUS_NUM" "$num" "$rest" "\033[1;37m$st\033[0m"
}
sshplus_opt_pair() {
	if [[ "${SSHPLUS_COMPACT:-0}" == 1 ]]; then
		sshplus_opt_cell "$1" "$2" "$3"
		printf '\n'
		sshplus_opt_cell "$4" "$5" "$6"
		printf '\n'
		return
	fi
	sshplus_opt_cell "$1" "$2" "$3" 16
	printf '   '
	sshplus_opt_cell "$4" "$5" "$6" 24
	printf '\n'
}
# Licenca: Install/list grava em /usr/lib/sshplus; verificacao antiga so lia /usr/lib/licence (menu vazio).
ensure_licence_conexao() {
	mkdir -p /usr/lib
	[[ -f /usr/lib/licence ]] && return 0
	[[ -f /usr/lib/sshplus ]] && cp -f /usr/lib/sshplus /usr/lib/licence && return 0
	[[ -f /etc/rec/licence ]] && cp -f /etc/rec/licence /usr/lib/licence && return 0
	echo 'By J DAVID AG' >/usr/lib/licence
	chmod 644 /usr/lib/licence
}
ensure_licence_conexao
: && {
	# Ubuntu 22+: netstat/ss mostram "python3"; o binario e so "python3" (sem "python")
	SSHPLUS_PY="$(command -v python3 2>/dev/null || command -v python 2>/dev/null || echo python3)"
	# free viene de procps; en VPS mínimas o PATH raro puede faltar → /proc/meminfo
	if command -v free >/dev/null 2>&1; then
		ram1=$(LC_ALL=C LANG=C free -h 2>/dev/null | grep -i mem | awk '{print $2}')
		ram2=$(LC_ALL=C LANG=C free -h 2>/dev/null | grep -i mem | awk '{print $4}')
		ram3=$(LC_ALL=C LANG=C free -h 2>/dev/null | grep -i mem | awk '{print $3}')
	elif [[ -x /usr/bin/free ]]; then
		ram1=$(LC_ALL=C LANG=C /usr/bin/free -h 2>/dev/null | grep -i mem | awk '{print $2}')
		ram2=$(LC_ALL=C LANG=C /usr/bin/free -h 2>/dev/null | grep -i mem | awk '{print $4}')
		ram3=$(LC_ALL=C LANG=C /usr/bin/free -h 2>/dev/null | grep -i mem | awk '{print $3}')
	else
		ram1=$(awk '/^MemTotal:/{printf "%.1fGi", $2/1024/1024}' /proc/meminfo 2>/dev/null)
		ram2=$(awk '/^MemAvailable:/{printf "%.1fGi", $2/1024/1024}' /proc/meminfo 2>/dev/null)
		ram3=$(awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} END{ if (t+0>0 && a+0>=0) printf "%.1fGi", (t-a)/1024/1024; else print "?" }' /proc/meminfo 2>/dev/null)
	fi
	uso=$(top -bn1 | awk '/Cpu/ { cpu = "" 100 - $8 "%" }; END { print cpu }')
	system=$(cat /etc/issue.net)
	fun_bar() {
		comando[0]="$1"
		comando[1]="$2"
		(
			[[ -e $HOME/fim ]] && rm $HOME/fim
			[[ ! -d /etc/SSHPlus ]] && rm -rf /bin/menu
			${comando[0]} >/dev/null 2>&1
			${comando[1]} >/dev/null 2>&1
			touch $HOME/fim
		) >/dev/null 2>&1 &
		tput civis
		echo -ne "${SSHPLUS_CYAN}ESPERE ${SCOLOR}\033[1;37m- ${SSHPLUS_CYAN}["
		while true; do
			for ((i = 0; i < 18; i++)); do
				echo -ne "${SSHPLUS_CYAN}#"
				sleep 0.1s
			done
			[[ -e $HOME/fim ]] && rm $HOME/fim && break
			echo -e "${SSHPLUS_CYAN}]${SCOLOR}"
			sleep 1s
			tput cuu1
			tput dl1
			echo -ne "${SSHPLUS_CYAN}ESPERE ${SCOLOR}\033[1;37m- ${SSHPLUS_CYAN}["
		done
		echo -e "${SSHPLUS_CYAN}]${SCOLOR}\033[1;37m - OK !\033[0m"
		tput cnorm
	}

	verif_ptrs() {
		porta=$1
		PT=$(lsof -V -i tcp -P -n | grep -v "ESTABLISHED" | grep -v "COMMAND" | grep "LISTEN")
		for pton in $(echo -e "$PT" | cut -d: -f2 | cut -d' ' -f1 | uniq); do
			svcs=$(echo -e "$PT" | grep -w "$pton" | awk '{print $1}' | uniq)
			[[ "$porta" = "$pton" ]] && {
				echo -e "\n\033[1;31mPUERTO \033[1;33m$porta \033[1;31mEN USO POR \033[1;37m$svcs\033[0m"
				sleep 3
				fun_conexao
			}
		done
	}

	# Puerto en LISTEN (evita falsos positivos del verif_ptrs global); vuelve al menú SOCKS, no sale de connection.
	verif_ptrs_socks() {
		local porta=$1
		if command -v lsof >/dev/null 2>&1; then
			local occ
			occ=$(lsof -iTCP:"$porta" -sTCP:LISTEN -n -P 2>/dev/null | tail -n +2)
			if [[ -n "$occ" ]]; then
				echo -e "\n\033[1;31mPUERTO \033[1;33m$porta \033[1;31mEN USO (LISTEN):\033[0m"
				echo "$occ"
				sleep 3
				fun_socks
			fi
		elif command -v ss >/dev/null 2>&1; then
			if ss -tln 2>/dev/null | grep -qE "[:,]${porta}([^0-9]|$)"; then
				echo -e "\n\033[1;31mPUERTO \033[1;33m$porta \033[1;31mEN USO (ss LISTEN)\033[0m"
				sleep 3
				fun_socks
			fi
		else
			verif_ptrs "$porta"
		fi
	}

	# Antes de activar SOCKS de nuevo: mata /etc/SSHPlus/proxy.py huérfano y sesión screen .proxy colgada.
	fun_socks_prepare_activate() {
		for _k in $(pgrep -f '/etc/SSHPlus/proxy.py' 2>/dev/null); do
			[[ "$_k" =~ ^[0-9]+$ ]] && kill "$_k" 2>/dev/null || true
		done
		sleep 0.2
		_pg_left="$(pgrep -f '/etc/SSHPlus/proxy.py' 2>/dev/null)"
		if [[ -n "${_pg_left// }" ]]; then
			for _k in $_pg_left; do
				[[ "$_k" =~ ^[0-9]+$ ]] && kill -9 "$_k" 2>/dev/null || true
			done
			sleep 0.2
		fi
		for _sp in $(screen -ls 2>/dev/null | grep '\.proxy' | awk '{print $1}'); do
			screen -r -S "$_sp" -X quit 2>/dev/null || true
		done
		screen -wipe >/dev/null 2>&1 || true
	}

	# Antes de activar WebSocket de nuevo: mata wsproxy.py huérfano y sesión screen .ws colgada.
	fun_ws_prepare_activate() {
		for _k in $(pgrep -f '/etc/SSHPlus/wsproxy.py' 2>/dev/null); do
			[[ "$_k" =~ ^[0-9]+$ ]] && kill "$_k" 2>/dev/null || true
		done
		sleep 0.2
		_ws_left="$(pgrep -f '/etc/SSHPlus/wsproxy.py' 2>/dev/null)"
		if [[ -n "${_ws_left// }" ]]; then
			for _k in $_ws_left; do
				[[ "$_k" =~ ^[0-9]+$ ]] && kill -9 "$_k" 2>/dev/null || true
			done
			sleep 0.2
		fi
		for _sp in $(screen -ls 2>/dev/null | grep '\.ws' | awk '{print $1}'); do
			screen -r -S "$_sp" -X quit 2>/dev/null || true
		done
		screen -wipe >/dev/null 2>&1 || true
	}

	slow_setup() {
		cd "$HOME" || return 1
		rm -f install
		echo -e "\033[1;33mDESCARGANDO INSTALADOR SLOWDNS...\033[0m"
		if command -v wget >/dev/null 2>&1; then
			wget -qO install https://raw.githubusercontent.com/fabricio94b/VPS-MANAGER/main/SlowDNS/install || true
		fi
		if [[ ! -s install ]] && command -v curl >/dev/null 2>&1; then
			curl -fsSL -o install https://raw.githubusercontent.com/fabricio94b/VPS-MANAGER/main/SlowDNS/install || true
		fi
		if [[ ! -s install ]]; then
			echo -e "\033[1;31mNo se pudo descargar el instalador de SlowDNS.\033[0m"
			echo -e "\033[1;33mRevise conexion a raw.githubusercontent.com o intente mas tarde.\033[0m"
			sleep 3
			return 1
		fi
		chmod +x install
		bash ./install

	}

	inst_sqd() {
		if netstat -nltp | grep 'squid' 1>/dev/null 2>/dev/null; then
			echo -e "\E[41;1;37m            ELIMINAR SQUID PROXY              \E[0m"
			echo ""
			echo -ne "\033[1;32m¿REALMENTE ELIMINAR SQUID \033[1;31m? \033[1;33m[s/n]:\033[1;37m "
			read resp
			[[ "$resp" = 's' ]] && {
				echo -e "\n\033[1;32mELIMINANDO EL SQUID PROXY !\033[0m"
				echo ""
				rem_sqd() {
					[[ -d "/etc/squid" ]] && {
						apt-get remove squid -y >/dev/null 2>&1
						apt-get purge squid -y >/dev/null 2>&1
						rm -rf /etc/squid >/dev/null 2>&1
					}
					[[ -d "/etc/squid3" ]] && {
						apt-get remove squid3 -y >/dev/null 2>&1
						apt-get purge squid3 -y >/dev/null 2>&1
						rm -rf /etc/squid3 >/dev/null 2>&1
						apt autoremove -y >/dev/null 2>&1
					}
				}
				fun_bar 'rem_sqd'
				echo -e "\n\033[1;32mSQUID ELIMINADO CON ÉXITO !\033[0m"
				sleep 2
				clear
				fun_conexao
			} || {
				echo -e "\n\033[1;31mVolviendo...\033[0m"
				sleep 2
				clear
				fun_conexao
			}
		else
			clear
			echo -e "\E[44;1;37m              INSTALADOR SQUID                \E[0m"
			echo ""
			IP=$(wget -qO- ipv4.icanhazip.com)
			echo -ne "\033[1;32mPARA CONTINUAR CONFIRME SEU IP: \033[1;37m"
			read -e -i $IP ipdovps
			[[ -z "$ipdovps" ]] && {
				echo -e "\n\033[1;31mIP invalido\033[1;32m"
				echo ""
				read -p "Escriba su IP: " IP
			}
			echo -e "\n\033[1;33m¿QUÉ PUERTOS DESEA USAR EN SQUID \033[1;31m?"
			echo -e "\n\033[1;33m[\033[1;31m!\033[1;33m] \033[1;32mDEFINA LOS PUERTOS EN SECUENCIA \033[1;33mEX: \033[1;37m80 8080"
			echo ""
			echo -ne "\033[1;32mINGRESE LOS PUERTOS\033[1;37m: "
			read portass
			[[ -z "$portass" ]] && {
				echo -e "\n\033[1;31mPuerto no valido!"
				sleep 3
				fun_conexao
			}
			for porta in $(echo -e $portass); do
				verif_ptrs $porta
			done
			[[ $(grep -wc '14' /etc/issue.net) != '0' ]] || [[ $(grep -wc '8' /etc/issue.net) != '0' ]] && {
				echo -e "\n\033[1;32mINSTALANDEL SQUID PROXY\033[0m\n"
				fun_bar 'apt update -y' "apt install squid3 -y"
			} || {
				echo -e "\n\033[1;31m[\033[1;36m1\033[1;31m] \033[1;37m• \033[1;33mSQUID VERSAO 3.3.X\n\033[1;31m[\033[1;36m2\033[1;31m] \033[1;37m• \033[1;33mSQUID VERSAO 3.5.X\033[0m\n"
				echo -ne "${SSHPLUS_CYAN}Opcion:${SCOLOR} "; read -e -i 1 opc
				[[ -z "$opc" ]] && {
					echo -e "\n\033[1;31mOpcion no valida!"
					sleep 2
					fun_conexao
				}
				[[ "$opc" != '1' ]] && {
					[[ "$opc" != '2' ]] && {
						echo -e "\n\033[1;31mOpcion no valida!"
						sleep 2
						fun_conexao
					}
				}
				echo -e "\n\033[1;32mINSTALANDEL SQUID PROXY\033[0m\n"
				fun_bar 'apt update -y' "instsqd $opc"
			}
			if [[ -d "/etc/squid/" ]]; then
				var_sqd="/etc/squid/squid.conf"
				var_pay="/etc/squid/payload.txt"
			elif [[ -d "/etc/squid3/" ]]; then
				var_sqd="/etc/squid3/squid.conf"
				var_pay="/etc/squid3/payload.txt"
			else
				echo -e "\n\033[1;33m[\033[1;31mERRO\033[1;33m]\033[1;37m: \033[1;33mEL SQUID PROXY CORROMPIÓ\033[0m"
				sleep 2
				fun_conexao
			fi
			cat <<-EOF >$var_pay
				.whatsapp.net/
				.facebook.net/
				.twitter.com/
				.speedtest.net/
			EOF
			cat <<-EOF >$var_sqd
				acl url1 dstdomain -i 127.0.0.1
				acl url2 dstdomain -i localhost
				acl url3 dstdomain -i $ipdovps
				acl url4 dstdomain -i /SSHPLUS?
				acl payload url_regex -i "$var_pay"
				acl all src 0.0.0.0/0

				http_access allow url1
				http_access allow url2
				http_access allow url3
				http_access allow url4
				http_access allow payload
				http_access deny all
				 
				#Portas
			EOF
			for Pts in $(echo -e $portass); do
				echo -e "http_port $Pts" >>$var_sqd
				[[ -f "/usr/sbin/ufw" ]] && ufw allow $Pts/tcp
			done
			cat <<-EOF >>$var_sqd
				#Nome squid
				visible_hostname SSHPLUS 
				via off
				forwarded_for off
				pipeline_prefetch off
			EOF
			sqd_conf() {
				[[ -d "/etc/squid/" ]] && {
					service ssh restart
					/etc/init.d/squid restart
					service squid restart
				}
				[[ -d "/etc/squid3/" ]] && {
					service ssh restart
					/etc/init.d/squid3 restart
					service squid3 restart
				}
			}
			echo -e "\n\033[1;32mCONFIGURANDEL SQUID PROXY\033[0m"
			echo ""
			fun_bar 'sqd_conf'
			echo -e "\n\033[1;32mSQUID INSTALADO CON ÉXITO!\033[0m"
			sleep 2.5s
			fun_conexao
		fi
	}

	addpt_sqd() {
		echo -e "\E[44;1;37m         AÑADIR PUERTO A SQUID         \E[0m"
		echo -e "\n\033[1;33mPUERTOS EN USO: \033[1;32m$sqdp\n"
		if [[ -f "/etc/squid/squid.conf" ]]; then
			var_sqd="/etc/squid/squid.conf"
		elif [[ -f "/etc/squid3/squid.conf" ]]; then
			var_sqd="/etc/squid3/squid.conf"
		else
			echo -e "\n\033[1;31mSQUID NO ESTÁ INSTALADO!\033[0m"
			echo -e "\n\033[1;31mVolviendo...\033[0m"
			sleep 2
			clear
			fun_squid
		fi
		echo -ne "\033[1;32m¿QUÉ PUERTO DESEA AÑADIR \033[1;33m?\033[1;37m "
		read pt
		[[ -z "$pt" ]] && {
			echo -e "\n\033[1;31mPuerto no valido!"
			sleep 2
			clear
			fun_conexao
		}
		verif_ptrs $pt
		echo -e "\n\033[1;32mAÑADIENDO PUERTO A SQUID!"
		echo ""
		sed -i "s/#Portas/#Portas\nhttp_port $pt/g" $var_sqd
		fun_bar 'sleep 2'
		echo -e "\n\033[1;32mREINICIANDO SQUID!"
		echo ""
		fun_bar 'service squid restart' 'service squid3 restart'
		echo -e "\n\033[1;32mPUERTO AÑADIDO CON ÉXITO!"
		sleep 3
		clear
		fun_squid
	}

	rempt_sqd() {
		echo -e "\E[41;1;37m        ELIMINAR PUERTO DE SQUID        \E[0m"
		echo -e "\n\033[1;33mPUERTOS EN USO: \033[1;32m$sqdp\n"
		if [[ -f "/etc/squid/squid.conf" ]]; then
			var_sqd="/etc/squid/squid.conf"
		elif [[ -f "/etc/squid3/squid.conf" ]]; then
			var_sqd="/etc/squid3/squid.conf"
		else
			echo -e "\n\033[1;31mSQUID NO ESTÁ INSTALADO!\033[0m"
			echo -e "\n\033[1;31mVolviendo...\033[0m"
			sleep 2
			clear
			fun_squid
		fi
		echo -ne "\033[1;32m¿QUÉ PUERTO DESEA ELIMINAR \033[1;33m?\033[1;37m "
		read pt
		[[ -z "$pt" ]] && {
			echo -e "\n\033[1;31mPuerto no valido!"
			sleep 2
			clear
			fun_conexao
		}
		if grep -E "$pt" $var_sqd >/dev/null 2>&1; then
			echo -e "\n\033[1;32mELIMINANDO PUERTO DE SQUID!"
			echo ""
			sed -i "/http_port $pt/d" $var_sqd
			fun_bar 'sleep 3'
			echo -e "\n\033[1;32mREINICIANDO SQUID!"
			echo ""
			fun_bar 'service squid restart' 'service squid3 restart'
			echo -e "\n\033[1;32mPUERTO ELIMINADO CON ÉXITO!"
			sleep 3.5s
			clear
			fun_squid
		else
			echo -e "\n\033[1;31mPUERTO \033[1;32m$pt \033[1;31mNO ENCONTRADA!"
			sleep 3.5s
			clear
			fun_squid
		fi
	}

	fun_squid() {
		[[ "$(netstat -nplt | grep -c 'squid')" = "0" ]] && inst_sqd
		echo -e "\E[44;1;37m          GESTIONAR SQUID PROXY           \E[0m"
		[[ "$(netstat -nplt | grep -c 'squid')" != "0" ]] && {
			sqdp=$(netstat -nplt | grep 'squid' | awk -F ":" {'print $4'} | xargs)
			echo -e "\n\033[1;33mPUERTOS\033[1;37m: \033[1;32m$sqdp"
			VarSqdOn="ELIMINAR SQUID PROXY"
		} || {
			VarSqdOn="INSTALAR SQUID PROXY"
		}
		echo -e "\n\033[1;31m[\033[1;36m1\033[1;31m] \033[1;37m• \033[1;33m$VarSqdOn \033[1;31m
[\033[1;36m2\033[1;31m] \033[1;37m• \033[1;33mAÑADIR PUERTO \033[1;31m
[\033[1;36m3\033[1;31m] \033[1;37m• \033[1;33mELIMINAR PUERTO\033[1;31m
[\033[1;36m0\033[1;31m] \033[1;37m• \033[1;33mVOLVER\033[0m"
		echo ""
		echo -ne "\033[1;32m¿QUÉ DESEA HACER \033[1;33m?\033[1;31m?\033[1;37m "
		read x
		clear
		case $x in
		1 | 01)
			inst_sqd
			;;
		2 | 02)
			addpt_sqd
			;;
		3 | 03)
			rempt_sqd
			;;
		0 | 00)
			echo -e "\033[1;31mVolviendo...\033[0m"
			sleep 1
			fun_conexao
			;;
		*)
			echo -e "\033[1;31mOpcao Invalida...\033[0m"
			sleep 2
			fun_conexao
			;;
		esac
	}

	fun_drop() {
		if netstat -nltp | grep 'dropbear' 1>/dev/null 2>/dev/null; then
			clear
			[[ $(netstat -nltp | grep -c 'dropbear') != '0' ]] && dpbr=$(netstat -nplt | grep 'dropbear' | awk -F ":" {'print $4'} | xargs) || sqdp="\033[1;31mINDISPONIBLE"
			if ps x | grep "limiter" | grep -v grep 1>/dev/null 2>/dev/null; then
				stats='\033[1;32mo '
			else
				stats='\033[1;31mx '
			fi
			echo -e "\E[44;1;37m              GESTIONAR DROPBEAR               \E[0m"
			echo -e "\n\033[1;33mPUERTOS\033[1;37m: \033[1;32m$dpbr"
			echo ""
			echo -e "\033[1;31m[\033[1;36m1\033[1;31m] \033[1;37m• \033[1;33mLIMITER DROPBEAR $stats\033[0m"
