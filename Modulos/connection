				sts7="\033[1;32mo "
			} || {
				sts7="\033[1;31mx "
			}

			[[ "$(netstat -tlpn | grep 'openvpn' | wc -l)" != '0' ]] && {
				echo -e "\033[1;32mSERVICIO: \033[1;33mOPENVPN: \033[1;32mPUERTO: \033[1;37m$(netstat -nplt | grep 'openvpn' | awk {'print $4'} | cut -d: -f2 | xargs)"
				sts5="\033[1;32mo "
			} || {
				sts5="\033[1;31mx "
			}

			[[ "$(netstat -tlpn 2>/dev/null | grep -E 'python3|/python' | wc -l)" != '0' ]] && {
				echo -e "\033[1;32mSERVICIO: \033[1;33mPROXY SOCKS \033[1;32mPUERTO: \033[1;37m$(netstat -nplt 2>/dev/null | grep -E 'python3|/python' | awk {'print $4'} | cut -d: -f2 | xargs)"
				sts4="\033[1;32mo "
			} || {
				sts4="\033[1;31mx "
			}
			_ssl_pt="$(netstat -nplt 2>/dev/null | grep -E 'stunnel|stunnel4' | awk '{print $4}' | cut -d: -f2 | xargs)"
			if [[ -n "${_ssl_pt// }" ]]; then
