IP=$(cat /etc/IP)
_sshplus_sync_sshplus_lang() {
	if [[ ! -f /bin/sshplus_lang ]] || ! grep -q 'sshplus_lang' /bin/sshplus_lang 2>/dev/null || ! grep -q 'L_USER_ADMIN' /bin/sshplus_lang 2>/dev/null || ! grep -q 'CONFIGURACION DE PROTOCOLOS\|PROTOCOL CONFIGURATION' /bin/sshplus_lang 2>/dev/null || ! grep -q 'L_SCRIPT_SETTINGS' /bin/sshplus_lang 2>/dev/null || ! grep -q 'L_CHECKUSERS' /bin/sshplus_lang 2>/dev/null; then
		wget -qO /bin/sshplus_lang "https://raw.githubusercontent.com/soportecrisdev/SCRIP_CRISDEV/main/Modulos/sshplus_lang" && chmod +x /bin/sshplus_lang
	fi
}
_sshplus_sync_sshplus_lang
[[ -f /bin/sshplus_lang ]] && . /bin/sshplus_lang
_sshplus_resize() {
	_sshplus_cols="$(tput cols 2>/dev/null || echo 80)"
	[[ ! "$_sshplus_cols" =~ ^[0-9]+$ ]] && _sshplus_cols=80
	if [[ "$_sshplus_cols" -lt 78 ]]; then
		_SSHPLUS_IW=$(( _sshplus_cols - 2 ))
		[[ "$_SSHPLUS_IW" -lt 42 ]] && _SSHPLUS_IW=42
		[[ "$_SSHPLUS_IW" -gt 58 ]] && _SSHPLUS_IW=58
		_SSHPLUS_COMPACT=1
	else
		_SSHPLUS_IW=58
		_SSHPLUS_COMPACT=0
	fi
}
_sshplus_resize
_SSHPLUS_CYAN=$'\033[38;2;76;228;255m'
_SSHPLUS_NUM=$'\033[1;38;2;0;255;127m'
_SSHPLUS_SECTION=$'\033[1;38;2;240;230;140m'
_SSHPLUS_DATA=$'\033[1;38;2;127;255;0m'
_SSHPLUS_COUNTER=$'\033[1;38;2;255;179;71m'
_sshplus_frame_pre() { :; }
_sshplus_K=$'\033[K'
_sshplus_clear() {
	printf '\033c\033[3J\033[H\033[2J\033[?25h'
	printf '\n%.0s' {1..80}
	printf '\033[H\033[3J\033[2J'
	_sshplus_resize
}
clear() { _sshplus_clear; }
_sshplus_pad24() {
	local s="${1:0:24}"
	while [[ ${#s} -lt 24 ]]; do s+=' '; done
	echo -n "$s"
}
_sshplus_pad66() {
	local s="${1:0:${_SSHPLUS_IW}}"
	while [[ ${#s} -lt ${_SSHPLUS_IW} ]]; do s+=' '; done
	echo -n "$s"
}
_sshplus_hbar() { local i; for ((i=0;i<_SSHPLUS_IW;i++)); do printf '='; done; }
_sshplus_box_top() { _sshplus_frame_pre; printf '%b' "$_SSHPLUS_CYAN"; _sshplus_hbar; printf '\033[0m%s\n' "$_sshplus_K"; }
_sshplus_box_bot() { _sshplus_frame_pre; printf '%b' "$_SSHPLUS_CYAN"; _sshplus_hbar; printf '\033[0m%s\n' "$_sshplus_K"; }
_sshplus_box_sep() { _sshplus_frame_pre; printf '%b' "$_SSHPLUS_CYAN"; _sshplus_hbar; printf '\033[0m%s\n' "$_sshplus_K"; }
_sshplus_box_triple() { _sshplus_box_sep; }
_sshplus_box_triple_mid() { _sshplus_box_sep; }
_sshplus_box_triple_bot() { _sshplus_box_sep; }
_sshplus_line() { local s; s=$(_sshplus_pad66 "$1"); _sshplus_frame_pre; printf '\033[1;37m%s\033[0m%s\n' "$s" "$_sshplus_K"; }
_sshplus_line_g() { local s; s=$(_sshplus_pad66 "$1"); _sshplus_frame_pre; printf '\033[1;32m%s\033[0m%s\n' "$s" "$_sshplus_K"; }
_sshplus_line_c() { local s; s=$(_sshplus_pad66 "$1"); _sshplus_frame_pre; printf '\033[1;36m%s\033[0m%s\n' "$s" "$_sshplus_K"; }
_sshplus_dash_label() { printf '%b%s\033[0m' "$_SSHPLUS_SECTION" "$1"; }
_sshplus_dash_value() { printf '%b%s\033[0m' "$_SSHPLUS_DATA" "$1"; }
_sshplus_dash_counter() { printf '%b%s\033[0m' "$_SSHPLUS_COUNTER" "$1"; }
_sshplus_status_mark() {
	"$@" >/dev/null 2>&1 && printf '\033[1;32mo\033[0m' || printf '\033[1;31mx\033[0m'
}
_sshplus_trim_label() {
	local text="$1" max="$2"
	[[ "$text" == *$'\033'* ]] && printf '%s' "$text" || printf '%s' "${text:0:max}"
}
_sshplus_dash_pad() {
	local text="$1" width="$2" plain="$3"
	printf '%b' "$text"
	printf '%*s' $(( width - ${#plain} > 0 ? width - ${#plain} : 0 )) ''
}
_sshplus_title() {
	local t="NoxuraSSH" w=${#t} l=$(( (_SSHPLUS_IW - w) / 2 )) r=$(( _SSHPLUS_IW - w - l ))
	_sshplus_frame_pre
	printf '%*s\033[1;34m%s\033[0m%*s%s\n' "$l" '' "$t" "$r" '' "$_sshplus_K"
}
_sshplus_cell20() {
	local s="${1:0:18}"
	while [[ ${#s} -lt 18 ]]; do s+=' '; done
	printf '%s' "$s"
}
_sshplus_kv_cell20() {
	local lab="$1" val="$2" pre fmt pl vis pref rest
	printf -v pre '.%s: ' "$lab"
	printf -v fmt '.%s: %s' "$lab" "$val"
	pl=${#pre}
	if [[ $pl -gt 18 ]]; then
		vis="${fmt:0:18}"
		printf '\033[1;32m%s\033[0m' "$vis"
		return
	fi
	vis="${fmt:0:18}"
	while [[ ${#vis} -lt 18 ]]; do vis+=' '; done
	vis="${vis:0:18}"
	pref="${vis:0:pl}"
	rest="${vis:pl}"
	printf '\033[1;32m%s\033[0m\033[1;37m%s\033[0m' "$pref" "$rest"
}
# Swap habilitado = SwapTotal > 0 en kB (sin swap de archivo/zram no mostrar fila)
_sshplus_swap_enabled() {
	local kb
	kb="$(awk '/^SwapTotal:/{print $2+0; exit}' /proc/meminfo 2>/dev/null)"
	[[ "${kb:-0}" -gt 0 ]]
}
_sshplus_draw_sys_dashboard() {
	local sw
	if [[ "${_SSHPLUS_COMPACT:-0}" == 1 && "${_SSHPLUS_IW:-0}" -lt 58 ]]; then
		_sshplus_frame_pre; _sshplus_dash_label "${L_SISTEMA:-SISTEMA}"; printf '%s\n' "$_sshplus_K"
		_sshplus_frame_pre; _sshplus_dash_label "OS: "; _sshplus_dash_value "${_system}  "; _sshplus_dash_label "${L_HORA:-Hora}: "; _sshplus_dash_value "$_hora"; printf '%s\n' "$_sshplus_K"
		_sshplus_frame_pre; _sshplus_dash_label "${L_MEM_RAM:-MEMORIA RAM}"; printf '%s\n' "$_sshplus_K"
		_sshplus_frame_pre; _sshplus_dash_label "${L_TOTAL:-Total}: "; _sshplus_dash_value "${_ram}  "; _sshplus_dash_label "RAM: "; _sshplus_dash_value "$_usor"; printf '%s\n' "$_sshplus_K"
		_sshplus_frame_pre; _sshplus_dash_label "${L_PROCESSADOR:-PROCESADOR}"; printf '%s\n' "$_sshplus_K"
		_sshplus_frame_pre; _sshplus_dash_label "${L_NUCLEOS:-Nucleos}: "; _sshplus_dash_value "${_core}  "; _sshplus_dash_label "CPU: "; _sshplus_dash_value "$_usop"; printf '%s\n' "$_sshplus_K"
	else
		_sshplus_frame_pre
		_sshplus_dash_label "${L_SISTEMA:-SISTEMA}"; printf '%*s' $((22 - ${#L_SISTEMA} > 0 ? 22 - ${#L_SISTEMA} : 1)) ''
		_sshplus_dash_label "${L_MEM_RAM:-MEMORIA RAM}"; printf '%*s' $((22 - ${#L_MEM_RAM} > 0 ? 22 - ${#L_MEM_RAM} : 1)) ''
		_sshplus_dash_label "${L_PROCESSADOR:-PROCESADOR}"; printf '%s\n' "$_sshplus_K"
		_sshplus_frame_pre
		_sshplus_dash_label "OS: "; _sshplus_dash_value "$_system"; printf '%*s' $((18 - ${#_system} > 0 ? 18 - ${#_system} : 1)) ''
		_sshplus_dash_label "${L_TOTAL:-Total}: "; _sshplus_dash_value "$_ram"; printf '%*s' $((15 - ${#_ram} > 0 ? 15 - ${#_ram} : 1)) ''
		_sshplus_dash_label "${L_NUCLEOS:-Nucleos}: "; _sshplus_dash_value "$_core"; printf '%s\n' "$_sshplus_K"
		_sshplus_frame_pre
		_sshplus_dash_label "${L_HORA:-Hora}: "; _sshplus_dash_value "$_hora"; printf '%*s' $((16 - ${#_hora} > 0 ? 16 - ${#_hora} : 1)) ''
		_sshplus_dash_label "RAM: "; _sshplus_dash_value "$_usor"; printf '%*s' $((18 - ${#_usor} > 0 ? 18 - ${#_usor} : 1)) ''
		_sshplus_dash_label "CPU: "; _sshplus_dash_value "$_usop"; printf '%s\n' "$_sshplus_K"
	fi
	_sshplus_box_sep
	if [[ ! -e /tmp/att ]]; then
		if [[ "${_SSHPLUS_COMPACT:-0}" == 1 && "${_SSHPLUS_IW:-0}" -lt 58 ]]; then
			_sshplus_frame_pre; _sshplus_dash_counter "${L_ONLINES:-Conectados}: ${_onlin}  "; _sshplus_dash_counter "${L_EXPIR:-Caducados}: ${_userexp}  "; _sshplus_dash_counter "${L_TOTAL:-Total}: $_tuser"; printf '%s\n' "$_sshplus_K"
		else
			_sshplus_frame_pre
			_sshplus_dash_pad "$(_sshplus_dash_counter "${L_ONLINES:-Conectados}")" 25 "${L_ONLINES:-Conectados}"
			_sshplus_dash_pad "$(_sshplus_dash_counter "${L_EXPIR:-Caducados}")" 25 "${L_EXPIR:-Caducados}"
			_sshplus_dash_counter "${L_TOTAL:-Total}"; printf '%s\n' "$_sshplus_K"
			_sshplus_frame_pre
			_sshplus_dash_pad "$(_sshplus_dash_counter "$_onlin")" 25 "$_onlin"
			_sshplus_dash_pad "$(_sshplus_dash_counter "$_userexp")" 25 "$_userexp"
			_sshplus_dash_counter "$_tuser"; printf '%s\n' "$_sshplus_K"
		fi
	else
		_sshplus_line "[!] ${L_ATUAL_DISP:-ACTUALIZACION DISPONIBLE} [!]"
	fi
	_sshplus_box_sep
	if _sshplus_swap_enabled; then
		sw=" ${L_MEM_SWAP:-SWAP}  ${L_TOTAL:-Total}: ${swap1}  ${L_EM_USO:-En uso}: ${swap3}  ${L_LIVRE:-Libre}: ${swap2} "
		_sshplus_line_c "$sw"
	fi
}
_sshplus_pair() {
	local n1="$1" l1="$2" n2="$3" l2="$4" left right s d1 d2
	d1="${n1#0}"
	d2="${n2#0}"
	[[ -z "$d1" ]] && d1="0"
	[[ -z "$d2" ]] && d2="0"
	if [[ "${_SSHPLUS_COMPACT:-0}" == 1 && "${_SSHPLUS_IW:-0}" -lt 50 ]]; then
		local max=$(( _SSHPLUS_IW - 10 ))
		[[ "$max" -lt 12 ]] && max=12
		l1="$(_sshplus_trim_label "$l1" "$max")"
		l2="$(_sshplus_trim_label "$l2" "$max")"
		if [[ -n "$n1$l1" ]]; then
			_sshplus_frame_pre
			printf '  %b[%s]\033[0m \033[1;37m> %-*s\033[0m%s\n' "$_SSHPLUS_NUM" "$d1" "$max" "$l1" "$_sshplus_K"
		fi
		if [[ -n "$n2$l2" ]]; then
			_sshplus_frame_pre
			printf '  %b[%s]\033[0m \033[1;37m> %-*s\033[0m%s\n' "$_SSHPLUS_NUM" "$d2" "$max" "$l2" "$_sshplus_K"
		fi
		return
	fi
	l1="$(_sshplus_trim_label "$l1" 18)"
	l2="$(_sshplus_trim_label "$l2" 18)"
	[[ -n "$n1$l1" ]] && printf -v left '[%s] > %-18s' "$d1" "$l1" || printf -v left '%-24s' ''
	[[ -n "$n2$l2" ]] && printf -v right '[%s] > %-18s' "$d2" "$l2" || printf -v right '%-24s' ''
	_sshplus_frame_pre
	printf '  %b%s\033[0m\033[1;37m%b\033[0m %b%s\033[0m\033[1;37m%b\033[0m%s\n' \
		"$_SSHPLUS_NUM" "${left:0:4}" "${left:4}" \
		"$_SSHPLUS_NUM" "${right:0:4}" "${right:4}" "$_sshplus_K"
}
_sshplus_single_opt() {
	local n="$1" label="$2" color="${3:-\033[1;37m}" d
	d="${n#0}"
	[[ -z "$d" ]] && d="0"
	_sshplus_frame_pre
	printf '  %b[%s]\033[0m  \033[1;37m>\033[0m %b%s\033[0m%s\n' "$_SSHPLUS_NUM" "$d" "$color" "$label" "$_sshplus_K"
}
_sshplus_main_opt() {
	local n="$1" label="$2" mark="$3" d max
	d="${n#0}"
	[[ -z "$d" ]] && d="0"
	max=$(( _SSHPLUS_IW - 10 ))
	[[ "$max" -lt 18 ]] && max=18
	label="$(_sshplus_trim_label "$label" "$max")"
	label="${label%"${label##*[![:space:]]}"}"
	_sshplus_frame_pre
	if [[ -n "$mark" ]]; then
		printf '  %b[%s]\033[0m \033[1;37m> %s\033[0m  %b%s\n' "$_SSHPLUS_NUM" "$d" "$label" "$mark" "$_sshplus_K"
	else
		printf '  %b[%s]\033[0m \033[1;37m> %s\033[0m%s\n' "$_SSHPLUS_NUM" "$d" "$label" "$_sshplus_K"
	fi
}
_sshplus_line_00() {
	local s
	printf -v s ' [0] > %s' "${L2_00}"
	_sshplus_line "$s"
}
_sshplus_prompt() { _sshplus_frame_pre; printf $'\033[1;36mOpcion: \033[0m'; }
_sshplus_user_menu() {
	local opt title
	title="${L_USER_ADMIN:-ADMINISTRAR USUARIOS}"
	while true; do
		_sshplus_clear
		_sshplus_box_top
		_sshplus_frame_pre
		printf '\033[1;34m%*s\033[0m%s\n' $(( (_SSHPLUS_IW + ${#title}) / 2 )) "$title" "$_sshplus_K"
		_sshplus_box_sep
		_sshplus_pair "01" "${L_M01:-CREAR USUARIO}" "06" "${L_M06:-CAMBIAR LIMITE}"
		_sshplus_pair "02" "${L_M02:-CREAR PRUEBA}" "07" "${L_M07:-CAMBIAR CLAVE}"
		_sshplus_pair "03" "${L_M03:-ELIMINAR USUARIO}" "08" "${L_M09:-INFORME DE USUARIOS}"
		_sshplus_pair "04" "${L_M04:-MONITOR ONLINE}" "09" "${L_M08:-ELIMINAR CADUCADOS}"
		_sshplus_pair "05" "${L_M05:-CAMBIAR FECHA}" "00" "${L2_33:-VOLVER}"
		_sshplus_box_bot
		_sshplus_prompt; read -r opt
		case "$opt" in
			1 | 01)
				clear
				_sshplus_sync_criarusuario
				createuser
				;;
			2 | 02)
				clear
				_sshplus_sync_criarteste
				createtest
				echo -ne "\n\033[1;31mENTER \033[1;33m${L_ENTER_MENU:-para volver al menu}\033[0m"; read
				;;
			3 | 03)
				clear
				_sshplus_sync_removeuser
				removeuser
				;;
			4 | 04)
				clear
				sshmonitor
				;;
			5 | 05)
				clear
				_sshplus_sync_changedate
				changedate
				;;
			6 | 06)
				clear
				_sshplus_sync_changelimit
				changelimit
				;;
			7 | 07)
				clear
				_sshplus_sync_alterarsenha
				changepass
				;;
			8 | 08)
				clear
				_sshplus_sync_infousers
				infousers
				echo -ne "\n\033[1;31mENTER \033[1;33m${L_ENTER_MENU:-para volver al menu}\033[0m"; read
				;;
			9 | 09)
				clear
				_sshplus_sync_expcleaner
				expcleaner
				echo ""
				sleep 3
				;;
			0 | 00)
				return 0
				;;
			*)
				echo -e "\n\033[1;31m${L_OPC_INVALIDA:-Opcion no valida!}\033[0m"
				sleep 2
				;;
		esac
	done
}
_sshplus_change_language_menu() {
	local lang_opt
	_sshplus_clear
	_sshplus_box_top
	_sshplus_line "              SELECT LANGUAGE - SELECCIONAR IDIOMA"
	_sshplus_box_sep
	_sshplus_single_opt "1" "Español"
	_sshplus_single_opt "2" "English"
	_sshplus_box_bot
	echo -ne "\033[1;36mOpcion: \033[0m"; read -r lang_opt
	mkdir -p /etc/SSHPlus 2>/dev/null || true
	case "$lang_opt" in
		2) printf '%s\n' "en" >/etc/SSHPlus/lang 2>/dev/null || true ;;
		*) printf '%s\n' "es" >/etc/SSHPlus/lang 2>/dev/null || true ;;
	esac
	_sshplus_sync_sshplus_lang
	[[ -f /bin/sshplus_lang ]] && . /bin/sshplus_lang
}
_sshplus_script_settings_menu() {
	local opt upd
	while true; do
		_sshplus_sync_sshplus_lang
		[[ -f /bin/sshplus_lang ]] && . /bin/sshplus_lang
		[[ -e /tmp/att ]] && upd="${L_SCRIPT_NEW_UPDATE:-[NUEVA ACTUALIZACION]}" || upd="${L_SCRIPT_UPDATED:-[ACTUALIZADO]}"
		_sshplus_clear
		_sshplus_box_top
		_sshplus_frame_pre
		printf '\033[1;34m%*s\033[0m%s\n' $(( (_SSHPLUS_IW + ${#L_SCRIPT_SETTINGS}) / 2 )) "${L_SCRIPT_SETTINGS:-AJUSTES DE SCRIPT}" "$_sshplus_K"
		_sshplus_box_sep
		_sshplus_single_opt "1" "${L_SCRIPT_INFO:-INFORMACION DE VPS}"
		_sshplus_single_opt "2" "${L_SCRIPT_UPDATE:-ACTUALIZAR SCRIPT} ${upd}"
		_sshplus_single_opt "3" "${L_SCRIPT_LANG:-CAMBIAR IDIOMA}"
		_sshplus_single_opt "4" "${L_SCRIPT_UNINSTALL:-DESINSTALAR SCRIPT}" "\033[1;31m"
		_sshplus_single_opt "0" "${L2_33:-VOLVER}"
		_sshplus_box_bot
		_sshplus_prompt; read -r opt
		case "$opt" in
			1 | 01)
				clear
				detalles
				echo -ne "\n\033[1;31mENTER \033[1;33m${L_ENTER_MENU:-para volver al menu}\033[0m"; read
				;;
			2 | 02)
				attscript
				;;
			3 | 03)
				_sshplus_change_language_menu
				;;
			4 | 04)
				clear
				delscript
				;;
			0 | 00)
				break
				;;
			*)
				echo -e "\n\033[1;31m${L_OPC_INVALIDA:-Opcion no valida!}\033[0m"
				sleep 2
				;;
		esac
	done
}
_sshplus_fmt_bytes() {
	awk -v b="${1:-0}" 'BEGIN {
		split("B KB MB GB TB", u, " ");
		i=1;
		while (b >= 1024 && i < 5) { b /= 1024; i++ }
		printf "%.2f %s", b, u[i]
	}'
}
_sshplus_fmt_rate() {
	awk -v b="${1:-0}" 'BEGIN {
		bps = b * 8;
		split("bps Kbps Mbps Gbps", u, " ");
		i=1;
		while (bps >= 1000 && i < 4) { bps /= 1000; i++ }
		printf "%.2f %s", bps, u[i]
	}'
}
_sshplus_default_iface() {
	ip route 2>/dev/null | awk '/default/ {print $5; exit}'
}
_sshplus_traffic_monitor() {
	local iface rx1 tx1 rx2 tx2 drx dtx ipaddr
	iface="$(_sshplus_default_iface)"
	[[ -z "$iface" ]] && iface="$(ls /sys/class/net 2>/dev/null | grep -v '^lo$' | head -1)"
	if [[ -z "$iface" || ! -r "/sys/class/net/$iface/statistics/rx_bytes" ]]; then
		clear
		echo -e "\033[1;31mNo se encontro una interfaz de red valida.\033[0m"
		echo -ne "\n\033[1;31mENTER \033[1;33m${L_ENTER_MENU:-para volver al menu}\033[0m"; read
		return
	fi
	trap 'trap - INT; clear; return 0' INT
	while true; do
		rx1="$(cat "/sys/class/net/$iface/statistics/rx_bytes" 2>/dev/null || echo 0)"
		tx1="$(cat "/sys/class/net/$iface/statistics/tx_bytes" 2>/dev/null || echo 0)"
		sleep 1
		rx2="$(cat "/sys/class/net/$iface/statistics/rx_bytes" 2>/dev/null || echo 0)"
		tx2="$(cat "/sys/class/net/$iface/statistics/tx_bytes" 2>/dev/null || echo 0)"
		drx=$((rx2 - rx1))
		dtx=$((tx2 - tx1))
		ipaddr="$(ip -4 addr show "$iface" 2>/dev/null | awk '/inet / {print $2; exit}' | cut -d/ -f1)"
		clear
		_sshplus_box_top
		_sshplus_line "                    TRAFICO DE RED"
		_sshplus_box_sep
		_sshplus_line " INTERFAZ        : ${iface}  IP: ${ipaddr:-N/A}"
		_sshplus_box_sep
		_sshplus_line " DESCARGA ACTUAL : $(_sshplus_fmt_rate "$drx")"
		_sshplus_line " SUBIDA ACTUAL   : $(_sshplus_fmt_rate "$dtx")"
		_sshplus_line " TOTAL RECIBIDO  : $(_sshplus_fmt_bytes "$rx2")"
		_sshplus_line " TOTAL ENVIADO   : $(_sshplus_fmt_bytes "$tx2")"
		_sshplus_box_sep
		_sshplus_line " CTRL+C para volver"
		_sshplus_box_bot
	done
}
_sshplus_network_security_menu() {
	local opt title
	title="${L_NET_SECURITY:-RED Y SEGURIDAD}"
	while true; do
		_sshplus_clear
		_sshplus_box_top
		_sshplus_frame_pre
		printf '\033[1;34m%*s\033[0m%s\n' $(( (_SSHPLUS_IW + ${#title}) / 2 )) "$title" "$_sshplus_K"
		_sshplus_box_sep
		_sshplus_single_opt "1" "${L_M20:-FIREWALL (PRO)}"
