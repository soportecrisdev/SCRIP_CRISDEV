#!/bin/bash
# lang=es changedate v3-2026
database="/root/usuarios.db"
SSHPLUS_CYAN=$'\033[38;2;76;228;255m'
SSHPLUS_NUM=$'\033[1;38;2;0;255;127m'

line() { echo -e "${SSHPLUS_CYAN}============================================================\033[0m"; }
title() {
	local text="$1" cols pad
	cols="$(tput cols 2>/dev/null || echo 60)"
	[[ "$cols" =~ ^[0-9]+$ ]] || cols=60
	[[ "$cols" -gt 60 ]] && cols=60
	[[ "$cols" -lt 40 ]] && cols=40
	[[ ${#text} -gt "$cols" ]] && text="${text:0:cols}"
	pad=$(( (cols - ${#text}) / 2 ))
	[[ "$pad" -lt 0 ]] && pad=0
	printf '%*s%b\033[1m%s\033[0m\n' "$pad" "" "$SSHPLUS_CYAN" "$text"
}

valid_sshplus_user() {
	local user="$1" uid
	[[ -z "$user" || "$user" == "nobody" || "$user" == systemd-* || "$user" == "_"* ]] && return 1
	uid="$(getent passwd "$user" 2>/dev/null | awk -F: '{print $3}')"
	[[ "$uid" =~ ^[0-9]+$ && "$uid" -ge 1000 ]]
}

show_error() {
	echo ""
	tput setaf 7; tput setab 1; tput bold
	echo "$1"
	[[ -n "$2" ]] && echo "$2"
	[[ -n "$3" ]] && echo "$3"
	tput sgr0
	echo ""
	exit 1
}

clear
line
title "CAMBIAR FECHA DE CADUCIDAD"
line
title "LISTA DE USUARIOS Y FECHA DE CADUCIDAD:"
line
echo -e "${SSHPLUS_CYAN}\033[1mUSUARIOS:                 EXPIRA:                  ESTADO:\033[0m"
echo -e "${SSHPLUS_CYAN}\033[1m------------------------------------------------------------\033[0m"

i=0
unset _userPass
while read -r user; do
	[[ -z "$user" ]] && continue
	valid_sshplus_user "$user" || continue
	i=$((i + 1))
	expire="$(chage -l "$user" | grep -E "Account expires" | cut -d ' ' -f3-)"
	if [[ "$expire" == "never" ]]; then
		datanormal="00/00/0000"
		estado="\033[1;33mSIN FECHA\033[0m"
	else
		databr="$(date -d "$expire" +"%Y%m%d")"
		hoje="$(date -d today +"%Y%m%d")"
		datanormal="$(date -d "$expire" '+%d/%m/%Y')"
		if [[ "$hoje" -ge "$databr" ]]; then
			estado="\033[1;31mCADUCO\033[0m"
		else
			estado="\033[1;32mVIGENTE\033[0m"
		fi
	fi
	printf '%b[%s]\033[0m \033[1;37m> %-18s %-24s%b\n' "$SSHPLUS_NUM" "$i" "$user" "$datanormal" "$estado"
	_userPass+="\n${i}:${user}"
done < <(awk '{print $1}' "$database" 2>/dev/null)

[[ "$i" -eq 0 ]] && { echo -e "\033[1;33mNo hay usuarios SSH creados por la script.\033[0m"; sleep 2; exit 0; }
line
echo -e "${SSHPLUS_NUM}[0]\033[0m \033[1;37m> CANCELAR\033[0m"
line

echo -ne "\033[1;32mOpcion\033[1;33m: \033[0m"; read -r option
[[ "$option" == "0" || "$option" == "00" ]] && { echo -e "\033[1;33mOperación cancelada.\033[0m"; sleep 1; exit 0; }
[[ -z "$option" ]] && show_error "Opción no valida. Seleccione un numero de la lista."

usuario="$(echo -e "${_userPass}" | grep -E "^${option}:" | cut -d: -f2)"
[[ -z "$usuario" ]] && show_error "Opción no valida. Seleccione un numero de la lista."
getent passwd "$usuario" >/dev/null 2>&1 || show_error "El usuario $usuario no existe."

echo ""
curr_exp="$(chage -l $usuario 2>/dev/null | grep -i 'account expires\|expira' | head -1)"
echo -e "\033[1;33mActual:\033[0m \033[1;37m${curr_exp}\033[0m"
echo ""
echo -e "\033[1;31mEJ:\033[1;33m(\033[1;32mFECHA: \033[1;37mDIA/MES/ANO \033[1;33mO \033[1;32mDIAS: \033[1;37m30\033[1;33m)"
echo ""
echo -ne "\033[1;32mNueva fecha o dias para el usuario \033[1;33m$usuario: \033[1;37m"; read -r inputdate

if [[ -z "$inputdate" ]]; then
	show_error "Introdujo una fecha no valida o inexistente." "Use el formato DIA/MES/ANO." "Ejemplo: 21/04/2027"
fi

if [[ "$inputdate" != */* ]]; then
	udata="$(date "+%d/%m/%Y" -d "+$inputdate days" 2>/dev/null)" || show_error "Introdujo una fecha no valida o inexistente."
	sysdate="$(echo "$udata" | awk -v FS=/ -v OFS=- '{print $3,$2,$1}')"
else
	udata="$inputdate"
	sysdate="$(echo "$inputdate" | awk -v FS=/ -v OFS=- '{print $3,$2,$1}')"
fi

date "+%Y-%m-%d" -d "$sysdate" >/dev/null 2>&1 || show_error "Introdujo una fecha no valida o inexistente." "Use el formato DIA/MES/ANO." "Ejemplo: 21/04/2027"

if ! echo "$inputdate" | egrep '[^a-zA-Z]' >/dev/null 2>&1; then
	show_error "Introdujo una fecha no valida o inexistente." "Use el formato DIA/MES/ANO." "Ejemplo: 21/04/2027"
fi

today="$(date -d today +"%Y%m%d")"
timemachine="$(date -d "$sysdate" +"%Y%m%d")"
if [[ "$today" -ge "$timemachine" ]]; then
	show_error "La fecha es pasada o es hoy." "Indique una fecha futura valida (DIA/MES/ANO)." "Ejemplo: 21/04/2027"
fi

chage -E "$sysdate" "$usuario"
echo ""
tput setaf 7; tput setab 4; tput bold
echo "Listo. Usuario $usuario nueva fecha: $udata"
tput sgr0
echo ""
echo -ne "\033[1;37m* \033[1;33mEnter para continuar\033[1;31m"
read enter
exit 0
